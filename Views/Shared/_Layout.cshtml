<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RCM Dashboard</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">

    <link rel="stylesheet"
          href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SmartMeterReadingDash.styles.css"
          asp-append-version="true" />
</head>

<body>

<header class="dashboard-header">

    <div class="header-left">

        <img src="~/images/bses-logo.png"
             class="logo"
             alt="BSES Logo" />

        <div class="header-title-section">

            <h4 class="title">
                RCM - Smart Meter Reading Dashboard
            </h4>

        </div>

    </div>

    <div class="header-right">

        <div class="dashboard-month-control">

            <span class="month-label">
                <i class="bi bi-calendar3"></i>
                Reading Month
            </span>

            <div class="month-input-wrapper">

                <input type="month"
                       id="readingMonth"
                       class="form-control form-control-sm" />

            </div>

            <button type="button"
                    class="btn btn-primary btn-sm"
                    id="btnLoadDashboard">

                <i class="bi bi-check2"></i>
                Apply

            </button>

        </div>

        <div class="user-menu">

            <button type="button"
                    class="user-menu-button"
                    id="userMenuButton">

                <span class="user-avatar">

                    @(User.Identity?.Name?
                        .Substring(0, 1)
                        .ToUpper() ?? "U")

                </span>

                <span class="user-info">

                    <strong>
                        @(User.Identity?.Name ?? "User")
                    </strong>

                    <small>
                        @(User.FindFirst(
                            System.Security.Claims.ClaimTypes.Role
                        )?.Value ?? "USER")
                    </small>

                </span>

                <span class="user-arrow">
                    ▾
                </span>

            </button>

            <div class="user-dropdown"
                 id="userDropdown">

                <div class="dropdown-user-info">

                    <div class="dropdown-avatar">

                        @(User.Identity?.Name?
                            .Substring(0, 1)
                            .ToUpper() ?? "U")

                    </div>

                    <div>

                        <strong>
                            @(User.Identity?.Name ?? "User")
                        </strong>

                        <span>
                            @(User.FindFirst(
                                System.Security.Claims.ClaimTypes.Role
                            )?.Value ?? "USER")
                        </span>

                    </div>

                </div>


                <div class="dropdown-divider"></div>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      id="logoutForm">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="dropdown-item logout-button">

                        <span>⇥</span>

                        Logout

                    </button>

                </form>

            </div>

        </div>

    </div>

</header>


    <main class="page-content">

        @RenderBody()

    </main>


    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>  window.appBasePath = '@Url.Content("~/")'; </script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/Auth.js"
            asp-append-version="true"></script>

    <script src="~/js/Dashboard/MeterType.js"
            asp-append-version="true"></script>

    <script src="~/js/Dashboard/MeterDownload.js"
            asp-append-version="true"></script>

    <script src="~/js/Dashboard/Departmentwise.js"
            asp-append-version="true"></script>

    <script src="~/js/Dashboard/ReadingTrend.js"
            asp-append-version="true"></script>

    <script src="~/js/Dashboard/Helper.js"
            asp-append-version="true"></script>

    <script src="~/js/Dashboard/Dashboard.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>