<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RCM Dashboard</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartMeterReadingDash.styles.css" asp-append-version="true" />

</head>

<body>

    <header class="dashboard-header">

        <div class="header-left">

            <!-- Replace with your logo -->
            <img src="~/images/bses-logo.png" class="logo" />

            <div>
                <h4 class="title">
                    RCM - BRPL Smart Meter Reading Dashboard
                </h4>

                <div class="month">
                    @DateTime.Now.ToString("MMMM yyyy")
                </div>

            </div>

        </div>

        <div class="generated">

            <small>Generated</small>

            <strong>
                @DateTime.Now.ToString("dd-MMM-yyyy HH:mm")
            </strong>

        </div>

    </header>

    <main class="page-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="~/js/Dashboard/MeterType.js"></script>
    <script src="~/js/Dashboard/MeterDownload.js"></script>
    <script src="~/js/Dashboard/Departmentwise.js"></script>
    <script src="~/js/Dashboard/ReadingTrend.js"></script>

    <script src="~/js/Dashboard/Dashboard.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>