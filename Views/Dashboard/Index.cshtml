                        </td>


                        <td>
                            ${escapeHesHtml(
                    x.sapDepartment
                )}
                        </td>


                        <td>
                            ${escapeHesHtml(
                    x.sapDivision
                )}
                        </td>


                        <td>
                            ${escapeHesHtml(
                    x.sapSeqNo
                )}
                        </td>


                        <td class="address-cell">
                            ${escapeHesHtml(
                    x.address,
                    "--"
                )}
                        </td>


                        <td>
                            ${escapeHesHtml(
                    x.meterType
                )}
                        </td>

                    </tr>
                `);

            }
        );
    }


