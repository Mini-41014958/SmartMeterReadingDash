<style>

/* ================================
   Meter Summary Card
================================ */

.meter-summary-card {
    height: 100% !important;
    min-height: 0 !important;
}

.meter-summary-card .card-body {
    padding: 16px;
}


/* ================================
   Summary Table
================================ */

.meter-summary-table {
    width: 100%;
}

.meter-summary-table table {
    width: 100%;
    margin-bottom: 0;
}

.meter-summary-table thead th {
    font-size: 14px;
    font-weight: 600;
    color: #52606d;
    text-transform: uppercase;
    background-color: #f8fafc;
    border-bottom: 1px solid #dee2e6;
    padding: 6px 7px;
}

.meter-summary-table tbody td {
    font-size: 14px;
    padding: 7px;
    vertical-align: middle;
    border-bottom: 0;
    font-weight:700;
}

.meter-summary-table tbody td:first-child {
    color: #1f2937;
}

.meter-summary-table tbody td:not(:first-child) {
    font-variant-numeric: tabular-nums;
}

    .reading-month-strip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        background: #eef4ff;
        border: 1px solid #cfe0ff;
        border-radius: 6px;
        color: #1d4ed8;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }
    /* =========================================
   Download Detailed Summary Table
========================================= */

#downloadSummaryTable {
    width: 100%;
    table-layout: fixed;
    min-width: 1250px;
}

/* Compact columns */
#downloadSummaryTable th:nth-child(1),
#downloadSummaryTable td:nth-child(1) {
    width: 55px;
}

#downloadSummaryTable th:nth-child(2),
#downloadSummaryTable td:nth-child(2) {
    width: 105px;
}

#downloadSummaryTable th:nth-child(3),
#downloadSummaryTable td:nth-child(3) {
    width: 125px;
}

#downloadSummaryTable th:nth-child(4),
#downloadSummaryTable td:nth-child(4) {
    width: 65px;
    text-align: center;
}

#downloadSummaryTable th:nth-child(5),
#downloadSummaryTable td:nth-child(5) {
    width: 95px;
}

#downloadSummaryTable th:nth-child(6),
#downloadSummaryTable td:nth-child(6) {
    width: 100px;
}

#downloadSummaryTable th:nth-child(7),
#downloadSummaryTable td:nth-child(7) {
    width: 75px;
}

#downloadSummaryTable th:nth-child(8),
#downloadSummaryTable td:nth-child(8) {
    width: auto;
}

#downloadSummaryTable th:nth-child(9),
#downloadSummaryTable td:nth-child(9) {
    width: 95px;
}

#downloadSummaryTable th:nth-child(10),
#downloadSummaryTable td:nth-child(10) {
    width: auto;
}

#downloadSummaryTable th:nth-child(11),
#downloadSummaryTable td:nth-child(11) {
    width: 145px;
}

/* Header */
#downloadSummaryTable thead th {
    white-space: nowrap;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 7px;
    vertical-align: middle;
}

/* Body */
#downloadSummaryTable tbody td {
    font-size: 10px;
    padding: 7px;
    vertical-align: middle;
}

/* Address - allow wrapping */
#downloadSummaryTable td:nth-child(8) {
    white-space: normal;
    word-break: break-word;
    line-height: 1.35;
}

/* Status - use available space */
#downloadSummaryTable td:nth-child(10) {
    white-space: normal;
    word-break: break-word;
}

/* Status badge should not force table wider */
#downloadSummaryTable td:nth-child(10) .badge {
    display: inline-block;
    max-width: 100%;
    white-space: normal;
    word-break: break-word;
    line-height: 1.35;
    text-align: left;
}

/* Keep table scrollable on smaller screens */
.table-responsive {
    overflow-x: auto;
}
    #readingTrendChart {
        cursor: pointer;
        pointer-events: auto !important;
    }

</style>

