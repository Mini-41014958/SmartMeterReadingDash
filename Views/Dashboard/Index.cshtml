
 <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
<div id="dashboardSkeleton">

    <!-- Skeleton cards -->
    <div class="row g-3">

        <div class="col-lg-4">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-line mt-3"></div>
                <div class="skeleton skeleton-line"></div>
                <div class="skeleton skeleton-circle mx-auto mt-3"></div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-table mt-3"></div>
            </div>
        </div>

    </div>

    <div class="row mt-3">

        <div class="col-lg-6">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-chart mt-3"></div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-chart mt-3"></div>
            </div>
        </div>

    </div>

</div>

<div id="dashboardContent" style="display:none;">

  <div class="container-fluid py-3">
        <div class="card border-0 shadow-sm mb-3 filter-toolbar">
            <div class="card-body py-2">

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">

                    <div class="d-flex align-items-center gap-3">

                        <div class="fw-semibold text-primary">
                            <i class="bi bi-calendar3"></i>
                            Reading Month
                        </div>

                        <input type="month"
                               id="readingMonth"
                               class="form-control form-control-sm"
                               style="width:160px;" />

                        <button class="btn btn-primary btn-sm px-3"
                                id="btnLoadDashboard">
                            <i class="bi bi-search"></i>
                            Apply
                        </button>

                    </div>

                   

                </div>

            </div>
        </div>
    <!-- Top Row -->
    <div class="row g-3 ">
            <!-- Meter Summary -->
            <div class="col-lg-4">

                <div class="card dashboard-card h-100">

                    <div class="card-header">
                        <i class="bi bi-speedometer2"></i>
                        Meter Summary
                    </div>

                    <div class="card-body">

                        <div class="row align-items-center">

                            <div class="col-6">

                                <table class="table table-sm table-borderless mb-0">

                                    <tbody>

                                        <tr>
                                            <td>Allied</td>
                                            <td class="fw-bold text-primary text-end"
                                                id="alliedCount">
                                                0
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>Kimbal</td>
                                            <td class="fw-bold text-success text-end"
                                                id="kimbalCount">
                                                0
                                            </td>
                                        </tr>

                                        <tr class="border-top">
                                            <th>Total</th>
                                            <th class="text-end"
                                                id="totalMeter">0</th>
                                        </tr>

                                    </tbody>

                                </table>

                            </div>

                            <div class="col-6">

                                <canvas id="meterTypeChart"
                                        height="220"></canvas>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        <!-- Meter Received -->
        <div class="col-lg-8">

            <div class="card dashboard-card h-100">

                <div class="card-header">
                    <i class="bi bi-download"></i>
                    Meter Received in MRO
                </div>

                <div class="card-body d-flex flex-column justify-content-center">

                    <div class="d-flex justify-content-between align-items-center mb-2">

                        <small class="text-muted">
                            Till Date <span id="summaryDate"></span>
                        </small>

                        <button class="btn btn-sm btn-primary"
                                id="btnViewDownloadDetails">
                            <i class="bi bi-table"></i> View Details
                        </button>

                    </div>

                    <table class="table table-borderless text-center align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Total</th>
                                <th>HES Download</th>
                                <th>Download Failed</th>
                                <th>Download %</th>
                                <th>Failed %</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td class="fw-bold fs-2" id="totalMeters">0</td>

                                <td class="fw-bold fs-2 text-success" id="hesDownload">0</td>

                                <td class="fw-bold fs-2 text-danger" id="downloadFailed">0</td>

                                <td class="fw-bold fs-2 text-primary" id="downloadPercentage">0%</td>

                                    <td class="fw-bold fs-2 text-danger" id="failedPercentage">0%</td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

    <!-- Charts -->

    <div class="row mt-3 g-2">

        <div class="col-lg-6">

            <div class="card dashboard-card">

                <div class="card-header">
                    Department Distribution
                </div>

                <div class="card-body">

                    <canvas id="departmentChart"
                            ></canvas>

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card dashboard-card">

                <div class="card-header">
                        Failure Reason Summary
                </div>

                <div class="card-body">

                    <canvas id="readingTrendChart"
                           ></canvas>

                </div>

            </div>

        </div>

    </div>

</div>

</div>

@* detailed summary  *@
<div class="modal fade"
     id="downloadSummaryModal"
     tabindex="-1">

<div class="modal-dialog modal-fullscreen modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Meter Download Detailed Summary
                </h5>

                <button class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <div class="row mb-3">

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Department</label>
                        <select id="departmentFilter" class="form-select">
                            <option value="">All Departments</option>
                        </select>
                    </div>

                </div>

            <div class="table-responsive" style="max-height:75vh;overflow:auto;">
                <table id="downloadSummaryTable" class="table table-bordered table-striped table-hover mb-0">
               <thead class="table-dark sticky-top">
                <tr>
                    <th>S.No.</th>
                    <th>Consumer Ref</th>
                    <th>Meter No</th>
                    <th>Department</th>
                    <th>Division</th>
                    <th>District</th>
                    <th style="min-width:350px;">Address</th>
                    <th>Meter Type</th>
                    <th>Status</th>
                    <th style="min-width:450px;">HES Failed Reason</th>
                    <th>Entry Date</th>
                </tr>
                </thead>

                <tbody id="downloadSummaryBody"></tbody>
                </table>
            </div>

            </div>

        </div>

    </div>

</div>

    @* detailed summary  *@
<div class="modal fade"
     id="downloadSummaryModal"
     tabindex="-1">

<div class="modal-dialog modal-fullscreen modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Meter Download Detailed Summary
                </h5>

                <button class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <div class="row mb-3">

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Department</label>
                        <select id="departmentFilter" class="form-select">
                            <option value="">All Departments</option>
                        </select>
                    </div>

                </div>

            <div class="table-responsive" style="max-height:75vh;overflow:auto;">
                <table id="downloadSummaryTable" class="table table-bordered table-striped table-hover mb-0">
               <thead class="table-dark sticky-top">
                <tr>
                    <th>S.No.</th>
                    <th>Consumer Ref</th>
                    <th>Meter No</th>
                    <th>Department</th>
                    <th>Division</th>
                    <th>District</th>
                    <th style="min-width:350px;">Address</th>
                    <th>Meter Type</th>
                    <th>Status</th>
                    <th style="min-width:450px;">HES Failed Reason</th>
                    <th>Entry Date</th>
                </tr>
                </thead>

                <tbody id="downloadSummaryBody"></tbody>
                </table>
            </div>

            </div>

        </div>

    </div>

</div>
<!-- 1. jQuery FIRST -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- 3. DataTables -->
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>

<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script>
let allDownloadData = [];
let filteredData = [];

// Open Modal
$("#btnViewDownloadDetails").on("click", function () {

    const modal = new bootstrap.Modal(
        document.getElementById("downloadSummaryModal")
    );

    modal.show();

    loadDownloadSummary();

});

// Load Data
async function loadDownloadSummary() {

    try {

        $("#downloadSummaryBody").html(`
            <tr>
                <td colspan="11" class="text-center">
                    Loading...
                </td>
            </tr>
        `);

        const response = await fetch(
            "/api/dashboardapi/meter-download-detailed-summary?readingMonth=" + getReadingMonth()
        );

        if (!response.ok)
            throw new Error("Unable to load data");

        allDownloadData = await response.json();

        filteredData = [...allDownloadData];

        loadDepartmentFilter();

        renderTable(filteredData);

    }
    catch (e) {

        console.error(e);

        $("#downloadSummaryBody").html(`
            <tr>
                <td colspan="11" class="text-center text-danger">
                    Failed to load data.
                </td>
            </tr>
        `);

    }

}

// Load Department Dropdown
function loadDepartmentFilter() {

    const ddl = $("#departmentFilter");

    ddl.empty();

    ddl.append('<option value="">All Departments</option>');

    const departments = [...new Set(
        allDownloadData
            .map(x => x.sapDepartment)
            .filter(x => x)
    )].sort();

    departments.forEach(function (d) {

        ddl.append(`<option value="${d}">${d}</option>`);

    });

}

// Department Filter Change
$("#departmentFilter").on("change", function () {

    applyFilters();

});

// Apply Department Filter
function applyFilters() {

    const dept = ($("#departmentFilter").val() || "").trim().toLowerCase();

    filteredData = allDownloadData.filter(function (x) {

        return (
            dept === "" ||
            (x.sapDepartment ?? "").trim().toLowerCase() === dept
        );

    });

    renderTable(filteredData);

}

// Render Table
function renderTable(data) {

    const tbody = $("#downloadSummaryBody");

    tbody.empty();

    if (data.length === 0) {

        tbody.append(`
            <tr>
                <td colspan="11" class="text-center">
                    No Records Found
                </td>
            </tr>
        `);

        return;

    }

    data.forEach(function (x, index) {

        let reasonBadge = '<span class="text-muted">--</span>';

        if (x.schedulerMessage) {

            let badge = "secondary";

            const msg = x.schedulerMessage.toUpperCase();

            if (msg.includes("SYSTEM TITLE"))
                badge = "danger";
            else if (msg.includes("TCP"))
                badge = "warning text-dark";
            else if (msg.includes("NO DATA"))
                badge = "info text-dark";
            else if (msg.includes("TIMEOUT"))
                badge = "primary";

            reasonBadge = `
                <span class="badge bg-${badge}">
                    ${x.schedulerMessage}
                </span>
            `;
        }

        const entryDate = x.entryDate
            ? new Date(x.entryDate).toLocaleString("en-GB")
            : "--";

        tbody.append(`
            <tr>

                <td class="text-center fw-bold">${index + 1}</td>

                <td>${x.consRef ?? ""}</td>

                <td>${x.meterNumber ?? ""}</td>

                <td>${x.sapDepartment ?? ""}</td>

                <td>${x.sapDivision ?? ""}</td>

                <td>${x.district ?? ""}</td>

                <td style="min-width:350px;white-space:normal;">
                    ${x.address ?? "--"}
                </td>

                <td class="text-center">
                    ${x.meterType ?? ""}
                </td>

                <td class="text-center">
                    <span class="badge bg-danger">
                        ${x.status ?? ""}
                    </span>
                </td>

                <td style="min-width:450px;white-space:normal;">
                    ${reasonBadge}
                </td>

                <td>
                    ${entryDate}
                </td>

            </tr>
        `);

    });

}
</script> 


