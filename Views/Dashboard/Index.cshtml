    function getFailureCategoryBYPL(reason) {

    // Normalize message:
    // Converts new lines / multiple spaces to single spaces
    const message = String(reason || "")
    .toUpperCase()
    .replace(/\s+/g, " ")
    .trim();


    // --------------------------------------------------------
    // 1. SYSTEM TITLE MISMATCH
    // --------------------------------------------------------

    if (
    message.includes("SYSTEM TITLE")
    ) {
    return "SYSTEM_TITLE";
    }


    // --------------------------------------------------------
    // 2. TCP CONNECTION FAILED
    // --------------------------------------------------------

    if (
    message.includes("TCP")
    ) {
    return "TCP";
    }


    if (
    message.includes("DATA NOT FOUND")
    ||
    message.includes("NO DATA")
    ||
    message.includes("DATA NOT AVAILABLE")
    ) {
    return "NO_DATA";
    }

    if (

    // Main exact pattern
    message.includes("DATE IS OLDER")

    ||

    // Alternative wording
    message.includes("DATE OLDER")

    ||

    // Additional protection for actual API error
    (
    message.includes("SMART METER")
    &&
    message.includes("OLDER")
    &&
    message.includes("FORMY")
    &&
    message.includes("SAP_MRO_DOWNLOAD_DATE")
    )

    ) {
    return "DATE_OLDER";
    }


    if (
    message.includes("TIMEOUT")
    ||
    message.includes("TIME OUT")
    ) {
    return "TIMEOUT";
    }


    // --------------------------------------------------------
    // 6. EVERYTHING ELSE
    // --------------------------------------------------------

    return "OTHER";
    }


    $("#departmentFilterBYPL")
    .off("change")
    .on("change", function () {

    applyFiltersBYPL();

    });


    $("#reasonFilterBYPL")
    .off("change")
    .on("change", function () {

    applyFiltersBYPL();

    });


    // ============================================================
    // APPLY FILTERS
    // ============================================================

    function applyFiltersBYPL() {

    const selectedDepartment = String(
    $("#departmentFilterBYPL").val() || ""
    )
    .trim()
    .toUpperCase();


    const selectedReason = String(
    $("#reasonFilterBYPL").val() || ""
    )
    .trim()
    .toUpperCase();


    filteredDataBypl = allDownloadDataBypl.filter(item => {


    // ----------------------------------------------------
    // DEPARTMENT FILTER
    // ----------------------------------------------------

    const itemDepartment = String(
    item.sapDepartment || ""
    )
    .trim()
    .toUpperCase();


    const departmentMatch =

    selectedDepartment === ""

    ||

    itemDepartment === selectedDepartment;


    // ----------------------------------------------------
    // GET CATEGORY FOR THIS ROW
    // ----------------------------------------------------

    const itemCategory =
    getFailureCategoryBYPL(
    item.schedulerMessage
    );


    // ----------------------------------------------------
    // REASON FILTER
    // ----------------------------------------------------

    const reasonMatch =

    selectedReason === ""

    ||

    itemCategory === selectedReason;


    return (
    departmentMatch
    &&
    reasonMatch
    );

    });


    // Debugging
    console.log(
    "BYPL Selected Department:",
    selectedDepartment
    );

    console.log(
    "BYPL Selected Reason:",
    selectedReason
    );

    console.log(
    "BYPL Total Records:",
    allDownloadDataBypl.length
    );

    console.log(
    "BYPL Filtered Records:",
    filteredDataBypl.length
    );


    renderTableBYPL(filteredDataBypl);
    }


    // ============================================================
    // GET FAILURE BADGE STYLE
    //
    // SAME CATEGORY FUNCTION AS FILTER
    // ============================================================

    function getFailureBadgeStyleBYPL(reason) {

    const category =
    getFailureCategoryBYPL(reason);


    switch (category) {


    // SYSTEM TITLE = RED
    case "SYSTEM_TITLE":

    return {
    background: "#dc3545",
    color: "#ffffff"
    };


    // TCP = ORANGE
    case "TCP":

    return {
    background: "#fd7e14",
    color: "#ffffff"
    };


    // NO DATA = YELLOW
    case "NO_DATA":

    return {
    background: "#ffc107",
    color: "#000000"
    };


    // DATE OLDER = TEAL
    case "DATE_OLDER":

    return {
    background: "#20c997",
    color: "#ffffff"
    };


    // TIMEOUT = GRAY
    case "TIMEOUT":

    return {
    background: "#6c757d",
    color: "#ffffff"
    };


    // OTHER = GRAY
    default:

    return {
    background: "#6c757d",
    color: "#ffffff"
    };
    }
    }


    // ============================================================
    // FORMAT ENTRY DATE
    // ============================================================

    function formatEntryDateBYPL(value) {

    if (!value) {
    return "--";
    }


    const date = new Date(value);


    if (isNaN(date.getTime())) {
    return String(value);
    }


    return date.toLocaleString(
    "en-GB",
    {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit"
    }
    );
    }


    // ============================================================
    // RENDER TABLE
    // ============================================================

    function renderTableBYPL(data) {

    const tbody =
    $("#downloadSummaryBodyBYPL");


    tbody.empty();


    // --------------------------------------------------------
    // NO RECORDS
    // --------------------------------------------------------

    if (
    !Array.isArray(data)
    ||
    data.length === 0
    ) {

    tbody.html(`
    <tr>
    <td colspan="11"
    class="text-center py-4 text-muted">
    No Records Found
    </td>
    </tr>
    `);

    return;
    }


    // --------------------------------------------------------
    // RENDER ROWS
    // --------------------------------------------------------

    data.forEach((x, index) => {


    const badgeStyle =
    getFailureBadgeStyleBYPL(
    x.schedulerMessage
    );


    const entryDate =
    formatEntryDateBYPL(
    x.entryDate
    );


    tbody.append(`

    <tr>

    <!-- S.NO -->
    <td class="text-center">
    ${index + 1}
    </td>


    <!-- CONS REF -->
    <td>
    ${escapeHtml(x.consRef || "")}
    </td>


    <!-- METER NUMBER -->
    <td>
    ${escapeHtml(x.meterNumber || "")}
    </td>


    <!-- PHASE -->
    <td class="text-center">
    ${escapeHtml(x.phase || "")}
    </td>


    <!-- DEPARTMENT -->
    <td>
    ${escapeHtml(x.sapDepartment || "")}
    </td>


    <!-- DIVISION -->
    <td>
    ${escapeHtml(x.sapDivision || "")}
    </td>


    <!-- SEQ NO -->
    <td>
    ${escapeHtml(x.sapSeqNo || "")}
    </td>


    <!-- ADDRESS -->
    <td class="address-cell">
    ${escapeHtml(x.address || "--")}
    </td>


    <!-- METER MAKE -->
    <td class="text-center">
    ${escapeHtml(x.meterType || "")}
    </td>


    <!-- FAILURE STATUS -->
    <td class="status-cell">

    <span
    class="badge"
    style="
    background-color:${badgeStyle.background};
    color:${badgeStyle.color};
    white-space:normal;
    display:inline-block;
    line-height:1.35;
    padding:6px 10px;
    max-width:100%;
    "
    >
    ${escapeHtml(
    x.schedulerMessage || "--"
    )}
    </span>

    </td>


    <!-- ENTRY DATE -->
    <td class="text-center">
    ${escapeHtml(entryDate)}
    </td>

    </tr>

    `);

    });
    }


    function escapeHtml(value) {

    if (
    value === null
    ||
    value === undefined
    ) {
    return "";
    }


    return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
    }


    // ============================================================
    // EXPORT TO EXCEL
    // ============================================================

    function exportTableToExcelBYPL() {

    const table =
    document.getElementById(
    "downloadSummaryTableBYPL"
    );


    if (!table) {

    console.error(
    "BYPL download table not found."
    );

    return;
    }


    const wb =
    XLSX.utils.book_new();


    const ws =
    XLSX.utils.table_to_sheet(table);


    // Column widths
    ws["!cols"] = [

    { wch: 7 },   // S.No
    { wch: 15 },  // Cons Ref
    { wch: 18 },  // Meter Number
    { wch: 10 },  // Phase
    { wch: 15 },  // Department
    { wch: 15 },  // Division
    { wch: 18 },  // Seq No
    { wch: 50 },  // Address
    { wch: 15 },  // Meter Make
    { wch: 55 },  // Status
    { wch: 22 }   // Entry Date

    ];


    // Auto filter
    ws["!autofilter"] = {
    ref: "A1:K1"
    };


    XLSX.utils.book_append_sheet(
    wb,
    ws,
    "Download Failed"
    );


    const fileDate =
    new Date()
    .toISOString()
    .split("T")[0];


    XLSX.writeFile(
    wb,
    "Download_Failed_Summary_BYPL_"
    + fileDate
    + ".xlsx"
    );
    }

    function exportTableToCSVBYPL() {

    const table =
    document.getElementById(
    "downloadSummaryTableBYPL"
    );


    if (!table) {

    console.error(
    "BYPL download table not found."
    );

    return;
    }


    const rows =
    table.querySelectorAll("tr");


    const csv = [];


    rows.forEach(row => {

    const columns =
    row.querySelectorAll("th, td");


    const rowData = [];


    columns.forEach(column => {

    const value =
    column.innerText
    .replace(/"/g, '""')
    .replace(/\r?\n|\r/g, " ")
    .trim();


    rowData.push(
    `"${value}"`
    );

    });


    csv.push(
    rowData.join(",")
    );

    });


    const blob = new Blob(
    [csv.join("\n")],
    {
    type: "text/csv;charset=utf-8;"
    }
    );


    const url =
    URL.createObjectURL(blob);


    const link =
    document.createElement("a");


    link.href = url;

    link.download =
    "Download_Failed_Summary_BYPL_"
    + new Date()
    .toISOString()
    .split("T")[0]
    + ".csv";


    document.body.appendChild(link);

    link.click();

    document.body.removeChild(link);

    URL.revokeObjectURL(url);
    }
</script>