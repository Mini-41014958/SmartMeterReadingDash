<script>

    let allHesDownloadData = [];
    let filteredHesDownloadData = [];


    $("#hesDownload").on("click", function() {

        const modal = new bootstrap.Modal(
            document.getElementById("HesDownloadSummaryModal")
        );

        modal.show();

        loadHesDownloadSummary();
    });

    async function loadHesDownloadSummary() {

        try {

            $("#hesDownloadSummaryBody").html(`
                <tr>
                    <td colspan="9" class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                        Loading...
                    </td>
                </tr>
            `);

            const response = await fetch(
                `${getApiUrl("dashboardapi/hes-download-meters-details")}?ReadingMonth=${encodeURIComponent(getReadingMonth())}`
            );

            if (!response.ok) {
                throw new Error("Unable to load HES download data");
            }

            allHesDownloadData = await response.json();

            filteredHesDownloadData = [...allHesDownloadData];

            loadHesDepartmentFilter();
            loadHesDivisionFilter();

            renderHesDownloadTable(filteredHesDownloadData);

        }
        catch (err) {

            console.error("HES Download Summary Error:", err);

            $("#hesDownloadSummaryBody").html(`
                <tr>
                    <td colspan="9" class="text-center text-danger py-4">
                        Failed to load data.
                        Error: ${err.message}
                    </td>
                </tr>
            `);
        }
    }

    function loadHesDepartmentFilter() {

        const ddl = $("#hesDepartmentFilter");

        ddl.empty();

        ddl.append(`
            <option value="">All Departments</option>
        `);

        const departments = [
            ...new Set(
                allHesDownloadData
                    .map(x => x.sapDepartment)
                    .filter(x => x !== null && x !== undefined && x !== "")
            )
        ].sort();

        departments.forEach(department => {

            ddl.append(`
                <option value="${escapeHesHtml(department)}">
                    ${escapeHesHtml(department)}
                </option>
            `);

        });
    }

    function loadHesDivisionFilter() {

        const ddl = $("#hesDivisionFilter");

        ddl.empty();

        ddl.append(`
            <option value="">All Division</option>
        `);

        const divisions = [
            ...new Set(
