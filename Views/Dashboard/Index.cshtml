    //BYPL

    // ============================================================
    // BYPL METER DOWNLOAD DETAIL
    // COMPLETE UPDATED SCRIPT
    // ============================================================

    let allDownloadDataBypl = [];
    let filteredDataBypl = [];


    // ============================================================
    // OPEN MODAL
    // ============================================================

    $("#btnViewHesFailedDetails")
    .off("click")
    .on("click", function () {

    const modalElement = document.getElementById(
    "downloadSummaryModalBYPL"
    );

    if (!modalElement) {
    console.error("BYPL modal not found.");
    return;
    }

    const modal =
    bootstrap.Modal.getOrCreateInstance(modalElement);

    modal.show();

    loadDownloadSummaryBYPL();
    });


    // ============================================================
    // LOAD DATA FROM API
    // ============================================================

    async function loadDownloadSummaryBYPL() {

    try {

    $("#downloadSummaryBodyBYPL").html(`
    <tr>
    <td colspan="11" class="text-center py-4">
    <div class="spinner-border spinner-border-sm text-primary"></div>
    <span class="ms-2">Loading...</span>
    </td>
    </tr>
    `);


    const readingMonth = getReadingMonth();


     const response = await fetch(
     `${getApiUrl("dashboardapi/meter-download-detailed-summary-bypl")}?readingMonth=${encodeURIComponent(readingMonth)}`
       );

    if (!response.ok) {
    throw new Error(
    "Unable to load data. HTTP " + response.status
    );
    }


    const result = await response.json();


    allDownloadDataBypl = Array.isArray(result)
    ? result
    : [];


    filteredDataBypl = [...allDownloadDataBypl];


    // Load filters
    loadDepartmentFilterBYPL();
    loadReasonFilterBYPL();


    // Render all records
    renderTableBYPL(filteredDataBypl);


    console.log(
    "BYPL Download Data:",
    allDownloadDataBypl
    );

    }
    catch (err) {

    console.error(
    "BYPL Download Summary Error:",
    err
    );


    $("#downloadSummaryBodyBYPL").html(`
    <tr>
    <td colspan="11"
    class="text-center text-danger py-4">
    Failed to load data:
    ${escapeHtml(err.message)}
    </td>
    </tr>
    `);
    }
    }


    // ============================================================
    // GET READING MONTH
    // ============================================================

    function getReadingMonth() {

    // Use dashboard selected month if available
    const selectedMonth = $("#readingMonth").val();

    if (selectedMonth) {
    return selectedMonth;
    }


    // Fallback to current month
    const now = new Date();

    return (
    now.getFullYear()
    + "-"
    + String(now.getMonth() + 1).padStart(2, "0")
    );
    }


    // ============================================================
    // LOAD DEPARTMENT FILTER
    // ============================================================

    function loadDepartmentFilterBYPL() {

    const ddl = $("#departmentFilterBYPL");

    ddl.empty();

    ddl.append(`
    <option value="">
    All Departments
    </option>
    `);


    const departments = [
    ...new Set(
    allDownloadDataBypl
    .map(x =>
    String(x.sapDepartment || "").trim()
    )
    .filter(Boolean)
    )
    ].sort();


    departments.forEach(department => {

    ddl.append(
    $("<option>", {
    value: department,
    text: department
    })
    );

    });
    }


    // ============================================================
    // LOAD FAILURE REASON FILTER
    //
    // IMPORTANT:
    // value = stable internal category
    // text  = display text for user
    // ============================================================

    function loadReasonFilterBYPL() {

    const ddl = $("#reasonFilterBYPL");

    ddl.empty();


    ddl.append(`
    <option value="">
    All Reasons
    </option>
    `);


    ddl.append(`
    <option value="SYSTEM_TITLE">
    System Title Mismatch
    </option>
    `);


    ddl.append(`
    <option value="TCP">
    TCP Connection Failed
    </option>
    `);


    ddl.append(`
    <option value="NO_DATA">
    Data Not Found in HES
    </option>
    `);


    ddl.append(`
    <option value="DATE_OLDER">
    Date Older Then FormY
    </option>
    `);


    ddl.append(`
    <option value="TIMEOUT">
    Timeout
    </option>
    `);


    ddl.append(`
    <option value="OTHER">
    Other
    </option>
    `);
    }


    // ============================================================
    // GET FAILURE CATEGORY
    //
    // ALL FILTERING AND COLORS USE THIS SAME FUNCTION
    // ============================================================

    function getFailureCategoryBYPL(reason) {

    // Normalize message:
    // Converts new lines / multiple spaces to single spaces
    const message = String(reason || "")
    .toUpperCase()
    .replace(/\s+/g, " ")
    .trim();


    // --------------------------------------------------------
    // 1. SYSTEM TITLE MISMATCH
    // --------------------------------------------------------

    if (
    message.includes("SYSTEM TITLE")
    ) {
    return "SYSTEM_TITLE";
    }


    // --------------------------------------------------------
    // 2. TCP CONNECTION FAILED
    // --------------------------------------------------------

    if (
    message.includes("TCP")
    ) {
    return "TCP";
    }


    // --------------------------------------------------------
    // 3. DATA NOT FOUND IN HES
    //
    // Examples handled:
    // Data not found in HES
    // No Data Found
    // No Data
    // --------------------------------------------------------

    if (
    message.includes("DATA NOT FOUND")
    ||
    message.includes("NO DATA")
    ||
    message.includes("DATA NOT AVAILABLE")
    ) {
    return "NO_DATA";
    }


    // --------------------------------------------------------
    // 4. DATE OLDER THEN / THAN FORMY
    //
    // ACTUAL ERROR:
    //
    // Smart Meter date is older then FormY
    // SAP_MRO_DOWNLOAD_DATE for the meter no
    //
    // IMPORTANT:
    // The actual message contains:
    // "DATE IS OLDER"
    // NOT "DATE OLDER"
    // --------------------------------------------------------

    if (

    // Main exact pattern
    message.includes("DATE IS OLDER")

    ||

    // Alternative wording
    message.includes("DATE OLDER")

    ||

    // Additional protection for actual API error
    (
    message.includes("SMART METER")
    &&
    message.includes("OLDER")
    &&
    message.includes("FORMY")
    &&
    message.includes("SAP_MRO_DOWNLOAD_DATE")
    )

    ) {
    return "DATE_OLDER";
    }


    // --------------------------------------------------------
    // 5. TIMEOUT
    // --------------------------------------------------------

    if (
    message.includes("TIMEOUT")
    ||
    message.includes("TIME OUT")
    ) {
    return "TIMEOUT";
    }


    // --------------------------------------------------------
    // 6. EVERYTHING ELSE
    // --------------------------------------------------------

    return "OTHER";
    }


    // ============================================================
    // FILTER EVENTS
    //
    // Remove old events first to prevent duplicate handlers
    // ============================================================

    $("#departmentFilterBYPL")
    .off("change")
    .on("change", function () {

    applyFiltersBYPL();

    });


    $("#reasonFilterBYPL")
    .off("change")
    .on("change", function () {

    applyFiltersBYPL();

    });


    // ============================================================
    // APPLY FILTERS
    // ============================================================

    function applyFiltersBYPL() {

    const selectedDepartment = String(
    $("#departmentFilterBYPL").val() || ""
    )
    .trim()
    .toUpperCase();


    const selectedReason = String(
    $("#reasonFilterBYPL").val() || ""
    )
    .trim()
    .toUpperCase();


    filteredDataBypl = allDownloadDataBypl.filter(item => {


    // ----------------------------------------------------
    // DEPARTMENT FILTER
    // ----------------------------------------------------

    const itemDepartment = String(
    item.sapDepartment || ""
    )
    .trim()
    .toUpperCase();


    const departmentMatch =

    selectedDepartment === ""

    ||

    itemDepartment === selectedDepartment;


    // ----------------------------------------------------
    // GET CATEGORY FOR THIS ROW
    // ----------------------------------------------------

    const itemCategory =
    getFailureCategoryBYPL(
    item.schedulerMessage
    );


    // ----------------------------------------------------
    // REASON FILTER
    // ----------------------------------------------------

    const reasonMatch =

    selectedReason === ""

    ||

    itemCategory === selectedReason;


    return (
    departmentMatch
    &&
    reasonMatch
    );

    });


    // Debugging
    console.log(
    "BYPL Selected Department:",
    selectedDepartment
    );

    console.log(
    "BYPL Selected Reason:",
    selectedReason
    );

    console.log(
    "BYPL Total Records:",
    allDownloadDataBypl.length
    );

    console.log(
    "BYPL Filtered Records:",
    filteredDataBypl.length
    );


    renderTableBYPL(filteredDataBypl);
    }


    // ============================================================
    // GET FAILURE BADGE STYLE
    //
    // SAME CATEGORY FUNCTION AS FILTER
    // ============================================================

    function getFailureBadgeStyleBYPL(reason) {

    const category =
    getFailureCategoryBYPL(reason);


    switch (category) {


    // SYSTEM TITLE = RED
    case "SYSTEM_TITLE":

    return {
    background: "#dc3545",
    color: "#ffffff"
    };


    // TCP = ORANGE
    case "TCP":

    return {
    background: "#fd7e14",
    color: "#ffffff"
    };


    // NO DATA = YELLOW
    case "NO_DATA":

    return {
    background: "#ffc107",
    color: "#000000"
    };


    // DATE OLDER = TEAL
    case "DATE_OLDER":

    return {
    background: "#20c997",
    color: "#ffffff"
    };


    // TIMEOUT = GRAY
    case "TIMEOUT":

    return {
    background: "#6c757d",
    color: "#ffffff"
    };


    // OTHER = GRAY
    default:

    return {
    background: "#6c757d",
    color: "#ffffff"
    };
    }
    }


    // ============================================================
    // FORMAT ENTRY DATE
    // ============================================================

    function formatEntryDateBYPL(value) {

    if (!value) {
    return "--";
    }


    const date = new Date(value);


    if (isNaN(date.getTime())) {
    return String(value);
    }


    return date.toLocaleString(
    "en-GB",
    {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit"
    }
    );
    }


    // ============================================================
    // RENDER TABLE
    // ============================================================

    function renderTableBYPL(data) {

    const tbody =
    $("#downloadSummaryBodyBYPL");


    tbody.empty();


    // --------------------------------------------------------
    // NO RECORDS
    // --------------------------------------------------------

    if (
    !Array.isArray(data)
    ||
    data.length === 0
    ) {

    tbody.html(`
    <tr>
    <td colspan="11"
    class="text-center py-4 text-muted">
    No Records Found
    </td>
    </tr>
    `);

    return;
    }


    // --------------------------------------------------------
    // RENDER ROWS
    // --------------------------------------------------------

    data.forEach((x, index) => {


    const badgeStyle =
    getFailureBadgeStyleBYPL(
    x.schedulerMessage
    );


    const entryDate =
    formatEntryDateBYPL(
    x.entryDate
    );


    tbody.append(`

    <tr>

    <!-- S.NO -->
    <td class="text-center">
    ${index + 1}
    </td>


    <!-- CONS REF -->
    <td>
    ${escapeHtml(x.consRef || "")}
    </td>


    <!-- METER NUMBER -->
    <td>
    ${escapeHtml(x.meterNumber || "")}
    </td>


    <!-- PHASE -->
    <td class="text-center">
    ${escapeHtml(x.phase || "")}
    </td>


    <!-- DEPARTMENT -->
    <td>
    ${escapeHtml(x.sapDepartment || "")}
    </td>


    <!-- DIVISION -->
    <td>
    ${escapeHtml(x.sapDivision || "")}
    </td>


    <!-- SEQ NO -->
    <td>
    ${escapeHtml(x.sapSeqNo || "")}
    </td>


    <!-- ADDRESS -->
    <td class="address-cell">
    ${escapeHtml(x.address || "--")}
    </td>


    <!-- METER MAKE -->
    <td class="text-center">
    ${escapeHtml(x.meterType || "")}
    </td>


    <!-- FAILURE STATUS -->
    <td class="status-cell">

    <span
    class="badge"
    style="
    background-color:${badgeStyle.background};
    color:${badgeStyle.color};
    white-space:normal;
    display:inline-block;
    line-height:1.35;
    padding:6px 10px;
    max-width:100%;
    "
    >
    ${escapeHtml(
    x.schedulerMessage || "--"
    )}
    </span>

    </td>


    <!-- ENTRY DATE -->
    <td class="text-center">
    ${escapeHtml(entryDate)}
    </td>

    </tr>

    `);

    });
    }


    // ============================================================
    // HTML ESCAPE
    // ============================================================

    function escapeHtml(value) {

    if (
    value === null
    ||
    value === undefined
    ) {
    return "";
    }


    return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
    }


