        { wch: 22 }     // Entry Date

    ];


    XLSX.utils.book_append_sheet(
        wb,
        ws,
        "Meter Download"
    );


    XLSX.writeFile(
        wb,
        "Meter_Download_Summary_BYPL_"
        + new Date()
            .toISOString()
            .split("T")[0]
        + ".xlsx"
    );
}


// ============================================================
// EXPORT CSV
// ============================================================

function exportTableToCSVBYPL() {

    const table =
        document.getElementById(
            "downloadSummaryTableBYPL"
        );


    const rows =
        table.querySelectorAll("tr");


    const csv = [];


    rows.forEach(row => {

        if (row.style.display === "none") {
            return;
        }


        const columns =
            row.querySelectorAll("th, td");


        const data = [];


        columns.forEach(column => {

            data.push(
                '"'
                + column.innerText
                    .replace(/"/g, '""')
                + '"'
            );

        });


        csv.push(data.join(","));

    });


    const blob = new Blob(
        [csv.join("\n")],
        {
            type: "text/csv;charset=utf-8;"
        }
    );


    const link =
        document.createElement("a");


    link.href =
        URL.createObjectURL(blob);


    link.download =
        "Meter_Download_Summary_BYPL_"
        + new Date()
            .toISOString()
            .split("T")[0]
        + ".csv";


    link.click();


    URL.revokeObjectURL(link.href);
}
</script>