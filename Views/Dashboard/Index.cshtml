   <!-- Modal for Detailed Summary -->
<div class="modal fade" id="downloadSummaryModal" tabindex="-1" role="dialog" aria-labelledby="downloadSummaryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="downloadSummaryModalLabel">
                  Download Failed Detailed Summary
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <!-- Filter Section -->
                <div class="filter-section">

                    <div class="row align-items-end g-2">

                        <!-- Department -->
                        <div class="col-lg-2 col-md-4">

                            <label class="form-label fw-bold">
                                Department
                            </label>

                            <select id="departmentFilter"
                                    class="form-select">

                                <option value="">
                                    All Departments
                                </option>

                            </select>

                        </div>

                        <div class="col-lg-2 col-md-4">

                            <label class="form-label fw-bold">
                                Division
                            </label>
                            <select id="divisionFilter" class="form-select">
                                <option value="">All Divisions</option>
                            </select>

                        </div>

                   

                        <!-- Failed Reason -->
                        <div class="col-lg-2 col-md-4">

                            <label class="form-label fw-bold">
                                Failed Reason
                            </label>

                            <select id="reasonFilter"
                                    class="form-select">

                                <option value="">
                                    All Reasons
                                </option>

                            </select>

                        </div>


                        <!-- Phase -->
                        <div class="col-lg-2 col-md-4">

                            <label class="form-label fw-bold">
                                Phase
                            </label>

                            <select id="phaseFilter"
                                    class="form-select">

                                <option value="">
                                    All Phases
                                </option>

                            </select>

                        </div>


                        <!-- Meter Make -->
                        <div class="col-lg-2 col-md-4">

                            <label class="form-label fw-bold">
                                Meter Make
                            </label>

                            <select id="meterMakeFilter"
                                    class="form-select">

                                <option value="">
                                    All Meter Makes
                                </option>

                            </select>

                        </div>


                        <!-- Entry Date From -->
                        <div class="col-lg-2 col-md-4">

                            <label class="form-label fw-bold">
                                Entry Date From
                            </label>

                            <input type="date"
                                   id="entryDateFrom"
                                   class="form-control">

                        </div>


                        <!-- Entry Date To -->
                        <div class="col-lg-2 col-md-4">

                            <label class="form-label fw-bold">
                                Entry Date To
                            </label>

                            <input type="date"
                                   id="entryDateTo"
                                   class="form-control">

                        </div>


                        <!-- Buttons -->
                        <div class="col-12 d-flex justify-content-between align-items-center mt-2">

                            <button type="button"
                                    id="btnClearDownloadFilters"
                                    class="btn btn-outline-secondary">

                                <i class="bi bi-x-circle"></i>
                                Clear Filters

                            </button>


                            <div class="export-buttons">

                                <button type="button"
                                        class="btn btn-success"
                                        onclick="exportTableToExcel()">

                                    <i class="bi bi-file-earmark-excel"></i>
                                    Excel

                                </button>


                                <button type="button"
                                        class="btn btn-primary"
                                        onclick="exportTableToCSV()">

                                    <i class="bi bi-file-earmark-csv"></i>
                                    CSV

                                </button>


                                <button type="button"
                                        class="btn btn-secondary"
                                        onclick="window.print()">

                                    <i class="bi bi-printer"></i>
                                    Print

                                </button>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Table -->
                <div class="table-responsive">

                    <table id="downloadSummaryTable" class="table table-bordered custom-table">

                        <thead class="table-light">

                            <tr>

                                <th>S.No.</th>
                                <th>Cons Ref</th>
                                <th>Meter Number</th>
                                <th>Phase</th>
                                <th>Department</th>
                                <th>Division</th>
                                <th>Seq No</th>     
                                <th>Meter Make</th>
                                <th>Failed Since</th>
                                <th>Total Failed Days</th>
                                <th>Status</th>
                                <th>Last Entry Date</th>
                                <th>Address</th>
                            </tr>

                        </thead>

                        <tbody id="downloadSummaryBody">   </tbody>

                    </table>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>

