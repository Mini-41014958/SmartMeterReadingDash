                                        <div class="meter-chart-wrapper">
                                            <canvas id="brplMeterTypeChart"></canvas>
                                        </div>

                                    </div>


                                    <!-- BYPL -->
                                    <div class="meter-chart-item">

                                        <div class="meter-chart-title">
                                            BYPL
