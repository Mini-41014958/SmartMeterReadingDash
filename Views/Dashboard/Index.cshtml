                                <th>Status</th>
                                <th>Entry Date</th>

                            </tr>

                        </thead>

                        <tbody id="downloadSummaryBody">
                        </tbody>

                    </table>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>

