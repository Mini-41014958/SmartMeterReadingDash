                                                    ALLIED
                                                </th>

                                                <th colspan="2"
                                                    class="text-center">
                                                    KIMBAL
                                                </th>

                                                <th rowspan="2"
                                                    class="text-end">
                                                    TOTAL
                                                </th>

                                            </tr>

                                            <!-- Sub Header -->
                                            <tr>

                                                <th class="text-end">
                                                    1PH
                                                </th>

                                                <th class="text-end">
                                                    3PH
                                                </th>

                                                <th class="text-end">
                                                    1PH
                                                </th>

                                                <th class="text-end">
                                                    3PH
                                                </th>

                                            </tr>

                                        </thead>

                                        <tbody>

                                            <tr>

                                                <td class="fw-semibold">
                                                    BRPL
                                                </td>

                                                <!-- Allied -->
                                                <td class="text-end"
                                                    id="brplAllied1Ph">
                                                    0
                                                </td>

                                                <td class="text-end"
                                                    id="brplAllied3Ph">
                                                    0
                                                </td>

                                                <!-- Kimbal -->
                                                <td class="text-end"
                                                    id="brplKimbal1Ph">
                                                    0
                                                </td>

                                                <td class="text-end"
                                                    id="brplKimbal3Ph">
                                                    0
                                                </td>

                                                <!-- Total -->
                                                <td class="text-end fw-bold"
                                                    id="brplTotalMeter">
                                                    0
                                                </td>

                                            </tr>


                                            <!-- ========================= -->
                                            <!-- BYPL -->
                                            <!-- ========================= -->

                                            <tr>

                                                <td class="fw-semibold">
                                                    BYPL
                                                </td>

                                                <!-- Allied -->
                                                <td class="text-end"
                                                    id="byplAllied1Ph">
                                                    0
                                                </td>

                                                <td class="text-end"
