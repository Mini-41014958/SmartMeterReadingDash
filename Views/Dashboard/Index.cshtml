<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- 3. DataTables -->
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>

<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script>
    let allDownloadData = [];
    let filteredData = [];

    // Open Modal
    $("#btnViewDownloadDetails").on("click", function () {

    const modal = new bootstrap.Modal(
    document.getElementById("downloadSummaryModal")
    );

    modal.show();
    loadDownloadSummary();
    });

    // Load Data
    async function loadDownloadSummary() {

    try {

    $("#downloadSummaryBody").html(`
    <tr>
    <td colspan="10" class="text-center py-4">
    <div class="spinner-border spinner-border-sm text-primary me-2"></div>
    Loading...
    </td>
    </tr>
    `);

    const response = await fetch(
    "/api/dashboardapi/meter-download-detailed-summary?readingMonth=" + getReadingMonth()
    );

    if (!response.ok)
    throw new Error("Unable to load data");

    allDownloadData = await response.json();
    filteredData = [...allDownloadData];

    loadDepartmentFilter();
    renderTable(filteredData);

    }
    catch (e) {

    console.error(e);

    $("#downloadSummaryBody").html(`
    <tr>
    <td colspan="10" class="text-center text-danger py-4">
    Failed to load data.
    </td>
    </tr>
    `);

    }

    }

    // Department Dropdown
    function loadDepartmentFilter() {

    const ddl = $("#departmentFilter");

    ddl.empty();

    ddl.append('<option value="">All Departments</option>');

    const departments = [...new Set(
    allDownloadData
    .map(x => x.sapDepartment)
    .filter(x => x)
    )].sort();

    departments.forEach(function (d) {

    ddl.append(`<option value="${d}">${d}</option>`);

    });

    }
    function loadReasonFilter() {

    const ddl = $("#reasonFilter");

    ddl.empty();

    ddl.append('<option value="">All Reasons</option>');

    const reasons = [
        "SYSTEM TITLE MISMATCH",
        "TCP CONNECTION FAILED",
        "NO DATA FOUND ODR",
        "OTHER"
    ];

    reasons.forEach(r => {
        ddl.append(`<option value="${r}">${r}</option>`);
    });
}
    loadReasonFilter();

    // Department Change
    $("#departmentFilter").on("change", function () {
    applyFilters();
    });

    $("#reasonFilter").on("change", function () {
    applyFilters();
        });
    // Apply Filter
   function applyFilters() {

    const dept = ($("#departmentFilter").val() || "").trim().toUpperCase();
    const reason = ($("#reasonFilter").val() || "").trim().toUpperCase();

    filteredData = allDownloadData.filter(function (x) {

        const departmentMatch =
            dept === "" ||
            (x.sapDepartment || "").toUpperCase() === dept;

        let reasonMatch = true;

        const msg = (x.schedulerMessage || "").toUpperCase();

        if (reason !== "") {

            switch (reason) {

                case "SYSTEM TITLE MISMATCH":
                    reasonMatch = msg.includes("SYSTEM TITLE");
                    break;

                case "TCP CONNECTION FAILED":
                    reasonMatch = msg.includes("TCP");
                    break;

                case "NO DATA FOUND ODR":
                    reasonMatch = msg.includes("NO DATA");
                    break;

                case "OTHER":
                    reasonMatch =
                        !msg.includes("SYSTEM TITLE") &&
                        !msg.includes("TCP") &&
                        !msg.includes("NO DATA") 
                    break;
            }
        }

        return departmentMatch && reasonMatch;

    });

    renderTable(filteredData);
}
    function renderTable(data) {

    if ($.fn.DataTable.isDataTable("#downloadSummaryTable")) {
        $("#downloadSummaryTable").DataTable().clear().destroy();
    }

    const rows = data.map((x, index) => {

        let bgColor = "#6C757D";
        let textColor = "#FFFFFF";

        const msg = (x.schedulerMessage || "").toUpperCase();

        if (msg.includes("SYSTEM TITLE")) {
            bgColor = "#DC3545";
        }
        else if (msg.includes("TCP")) {
            bgColor = "#FD7E14";
        }
        else if (msg.includes("NO DATA")) {
            bgColor = "#FFC107";
            textColor = "#000000";
        }
        else if (msg.includes("TIMEOUT")) {
            bgColor = "#0D6EFD";
        }

        const reasonBadge = `
            <div style="
                background:${bgColor};
                color:${textColor};
                padding:6px 10px;
                border-radius:4px;
                font-size:12px;
                line-height:1.35;
                white-space:normal;
                word-break:break-word;
                overflow-wrap:anywhere;">
                ${x.schedulerMessage ?? "--"}
            </div>
        `;

        const entryDate = x.entryDate
            ? new Date(x.entryDate).toLocaleString("en-GB")
            : "--";

        return [
            x.consRef ?? "",
            x.meterNumber ?? "",
            x.sapDepartment ?? "",
            x.sapDivision ?? "",
            x.sapSeqNo ?? "",
            `<div style="white-space:normal;word-break:break-word;max-width:350px;">
                ${x.address ?? "--"}
            </div>`,
            x.meterType ?? "",
            reasonBadge,
            entryDate
        ];
    });

    $("#downloadSummaryTable").DataTable({

        destroy: true,
        data: rows,

        columns: [
            { title: "Consumer Ref" },
            { title: "Meter No" },
            { title: "Department" },
            { title: "Division" },
            { title: "SAP Seq No" },
            { title: "Address" },
            { title: "Meter Type" },
            { title: "HES Failed Reason" },
            { title: "Entry Date" }
        ],

        pageLength: 25,

        lengthMenu: [
            [10, 25, 50, 100, -1],
            [10, 25, 50, 100, "All"]
        ],

       responsive: false,
        autoWidth: false,

        scrollX: true,
        scrollY: "65vh",
        scrollCollapse: true,

        order: [[0, "asc"]],

        dom: 'Bfrtip',

     columnDefs: [

    {
        targets: "_all",
        className: "align-middle"
    },

    {
        targets: [0,1,2,3,4,6,8],
        className: "text-center"
    },
    {
        targets:0,
        width:"7%"
    },
    {
        targets:1,
        width:"8%",
    },
    {
        targets:2,
        width:"4%"
    },
    {
        targets:3,
        width:"6%"
    },
    {
        targets:4,
        width:"6%"
    },
    
    {
        targets: 5,
        width: "20%"
    },
    {
        targets: 6,
        width:"6%"
    },
    
    {
        targets: 7,
        width: "18%"
    },
    {
        targets:8,
        width:"10%"
    },

    {
        targets: [5],
        orderable: false
    }

]

    });

}

        
</script>


