<link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />


<div id="dashboardSkeleton">

    <!-- Skeleton cards -->
    <div class="row g-3">

        <div class="col-lg-4">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-line mt-3"></div>
                <div class="skeleton skeleton-line"></div>
                <div class="skeleton skeleton-circle mx-auto mt-3"></div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-table mt-3"></div>
            </div>
        </div>

    </div>

    <div class="row mt-3">

        <div class="col-lg-6">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-chart mt-3"></div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-chart mt-3"></div>
            </div>
        </div>

    </div>

</div>

<div id="dashboardContent" style="display:none;">

  <div class="container-fluid py-1">   

        <div class="row g-3">

            <div class="col-lg-6">

                <div class="card dashboard-card meter-summary-card h-100">

                    <div class="card-header">
                        <i class="bi bi-speedometer2"></i> Meter Summary
                    </div>

                    <div class="card-body">

                        <div class="row g-2 align-items-center">

                            <div class="col-md-7">

                                <div class="meter-summary-table">

                                    <table class="table table-sm mb-0">

                                        <thead>
                                            <tr>

                                                <th rowspan="2">Utility </th>

                                                <th colspan="2" class="text-center"> ALLIED</th>

                                                <th colspan="2" class="text-center"> KIMBAL </th>

                                                <th rowspan="2" class="text-end"> TOTAL </th>

                                            </tr>

                                            <!-- Sub Header -->
                                            <tr>

                                                <th class="text-end"> 1PH </th>

                                                <th class="text-end"> 3PH </th>

                                                <th class="text-end"> 1PH</th>

                                                <th class="text-end">3PH </th>

                                            </tr>

                                        </thead>

                                        <tbody>

                                            <tr>

                                                <td class="fw-semibold"> BRPL </td>

                                                <!-- Allied -->
                                                <td class="text-end" id="brplAllied1Ph"> 0 </td>

                                                <td class="text-end" id="brplAllied3Ph"> 0 </td>

                                                <!-- Kimbal -->
                                                <td class="text-end" id="brplKimbal1Ph"> 0 </td>

                                                <td class="text-end" id="brplKimbal3Ph"> 0 </td>

                                                <!-- Total -->
                                                <td class="text-end fw-bold" id="brplTotalMeter"> 0</td>

                                            </tr>

                                            <!-- BYPL -->

                                            <tr>

                                                <td class="fw-semibold"> BYPL </td>

                                                <!-- Allied -->
                                                <td class="text-end"
                                                    id="byplAllied1Ph">
                                                    0
                                                </td>

                                                <td class="text-end"
                                                    id="byplAllied3Ph">
                                                    0
                                                </td>

                                                <!-- Kimbal -->
                                                <td class="text-end"
                                                    id="byplKimbal1Ph">
                                                    0
                                                </td>

                                                <td class="text-end"
                                                    id="byplKimbal3Ph">
                                                    0
                                                </td>

                                                <!-- Total -->
                                                <td class="text-end fw-bold"
                                                    id="byplTotalMeter">
                                                    0
                                                </td>

                                            </tr>

                                        </tbody>

                                    </table>

                                </div>

                            </div>


                            <!-- ========================= -->
                            <!-- PIE CHARTS -->
                            <!-- ========================= -->

                            <div class="col-md-5">

                                <div class="meter-charts-wrapper">

                                    <!-- BRPL -->
                                    <div class="meter-chart-item">

                                        <div class="meter-chart-title">
                                            BRPL
                                        </div>

                                        <div class="meter-chart-wrapper">
                                            <canvas id="brplMeterTypeChart"></canvas>
                                        </div>

                                    </div>


                                    <!-- BYPL -->
                                    <div class="meter-chart-item">

                                        <div class="meter-chart-title">
                                            BYPL
                                        </div>

                                        <div class="meter-chart-wrapper">
                                            <canvas id="byplMeterTypeChart"></canvas>
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-lg-6">

                <div class="card dashboard-card h-100">

                    <div class="card-header">
                        <i class="bi bi-download"></i>
                        Meter Received in MRO
                    </div>

                    <div class="card-body p-2">

                        <div class="mro-company-row">

                            <div class="mro-company">
                                <span class="company-badge brpl-badge">
                                    BRPL
                                </span>
                            </div>

                            <!-- DOWNLOAD -->
                            <div class="mro-metric">
                                <div class="mro-label">Download</div>

                                <div class="mro-value text-success">

                                    <a href="javascript:void(0)"
                                       class="text-success" style="text-decoration:none;"
                                       id="hesDownload">
                                        0
                                    </a>

                                    <small id="downloadPercentage">(0%)</small>

                                </div>
                            </div>

                            <!-- FAILED -->
                            <div class="mro-metric">
                                <div class="mro-label">Failed</div>

                                <div class="mro-value">
                                    <a href="javascript:void(0)"
                                       class="mro-link mro-failed-value"
                                       id="downloadFailed">
                                        0
                                    </a>

                                    <small id="failedPercentage">(0%)</small>
                                </div>
                            </div>

                            <!-- TOTAL -->
                            <div class="mro-metric">
                                <div class="mro-label">Total</div>

                                <div class="mro-value"
                                     id="totalMeters">
                                    0
                                </div>
                            </div>

                            <!-- BILLED -->
                            <div class="mro-metric">
                                <div class="mro-label">Billed</div>

                                <div class="mro-value text-primary">
                                    <span id="billedMeters">0</span>
                                    <small id="billedPercentage">(0%)</small>
                                </div>
                            </div>

                            <!-- BILLED FAILED -->
                            <div class="mro-metric">
                                <div class="mro-label">Billed Failed</div>

                                <div class="mro-value">
                                    <a href="javascript:void(0)"
                                       class="mro-link mro-failed-value"
                                       id="billedFailed">
                                        0
                                    </a>

                                    <small id="billedFailedPercentage">(0%)</small>
                                </div>
                            </div>

                        </div>


                        <!-- ========================= BYPL  ========================== -->
                        <div class="mro-company-row">

                            <div class="mro-company">
                                <span class="company-badge bypl-badge">
                                    BYPL
                                </span>
                            </div>

                            <!-- DOWNLOAD -->
                            <div class="mro-metric">
                                <div class="mro-label">Download</div>

                                <div class="mro-value text-success">
                                     <a href="javascript:void(0)"
                                       class="text-success" style="text-decoration:none;"
                                       id="byplHesDownload">
                                        0
                                    </a>
                                    <small id="byplDownloadPercentage">(0%)</small>
                                </div>
                            </div>

                            <!-- FAILED -->
                            <div class="mro-metric">
                                <div class="mro-label">Failed</div>

                                <div class="mro-value">
                                    <a href="javascript:void(0)"
                                       class="mro-link mro-failed-value"
                                       id="byplDownloadFailed">
                                        0
                                    </a>

                                    <small id="byplFailedPercentage">(0%)</small>
                                </div>
                            </div>

                            <!-- TOTAL -->
                            <div class="mro-metric">
                                <div class="mro-label">Total</div>

                                <div class="mro-value"
                                     id="byplTotalMeters">
                                    0
                                </div>
                            </div>

                            <!-- BILLED -->
                            <div class="mro-metric">
                                <div class="mro-label">Billed</div>

                                <div class="mro-value text-primary">
                                    <span id="byplBilledMeters">0</span>
                                    <small id="byplBilledPercentage">(0%)</small>
                                </div>
                            </div>

                            <!-- BILLED FAILED -->
                            <div class="mro-metric">
                                <div class="mro-label">Billed Failed</div>

                                <div class="mro-value">
                                    <a href="javascript:void(0)"
                                       class="mro-link mro-failed-value"
                                       id="byplBilledFailed">
                                        0
                                    </a>

                                    <small id="byplBilledFailedPercentage">(0%)</small>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

</div>

    <!-- Charts -->

    <div class="row mt-3 g-2">

        <div class="col-lg-6">

            <div class="card dashboard-card">

                <div class="card-header">
                    Department Distribution
                </div>

                <div class="card-body">

                    <canvas id="departmentChart"
                            ></canvas>

                </div>

            </div>

        </div>
        <div class="col-lg-6">

            <div class="card dashboard-card h-100">

                <div class="card-header">
                    Failure Reason Summary
                </div>

                <div class="card-body">

                    <div style="height: 420px;">
                        <canvas id="readingTrendChart"></canvas>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

</div>

