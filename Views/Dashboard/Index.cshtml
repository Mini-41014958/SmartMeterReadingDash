@using System.Security.Claims

@{

    ViewBag.Title = "RCM - Smart Meter Reading Dashboard";

    var userCompany = User.FindFirst("Company")?.Value?.Trim().ToUpperInvariant() ?? "";

    var userRole =  User.FindFirst(ClaimTypes.Role)?.Value?.Trim().ToUpperInvariant()  ?? User.FindFirst("Role")?.Value?.Trim().ToUpperInvariant() ?? "";

    var isSuperAdmin =  userRole.Equals("SUPERADMIN", StringComparison.OrdinalIgnoreCase);


    // var showBrpl = isSuperAdmin || userCompany.Equals("BRPL", StringComparison.OrdinalIgnoreCase);

    // var showBypl =isSuperAdmin ||  userCompany.Equals("BYPL", StringComparison.OrdinalIgnoreCase);
    var showBrpl = true;

    // BYPL temporarily disabled
    // var showBypl = isSuperAdmin || userCompany.Equals("BYPL", StringComparison.OrdinalIgnoreCase);
    var showBypl = false;
}

<link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />


<div id="dashboardSkeleton">

    <!-- Skeleton cards -->
    <div class="row g-3">

        <div class="col-lg-4">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-line mt-3"></div>
                <div class="skeleton skeleton-line"></div>
                <div class="skeleton skeleton-circle mx-auto mt-3"></div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-table mt-3"></div>
            </div>
        </div>

    </div>

    <div class="row mt-3">

        <div class="col-lg-6">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-chart mt-3"></div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-chart mt-3"></div>
            </div>
        </div>

    </div>

</div>

<div id="dashboardContent" style="display:none;">

  <div class="container-fluid py-1">       

        <div class="row g-3">

            <div class="col-xl-6 col-lg-6 col-md-12">

                <div class="card dashboard-card meter-summary-card h-100">

                    <div class="card-header">
                        <i class="bi bi-speedometer2 me-1"></i>
                        Meter Summary
                    </div>

                    <div class="card-body">

                        <div class="row g-3 align-items-center">
                            <div class="col-lg-8 col-md-8 col-sm-12">

                                <div class="meter-summary-table">

                                    <table class="table table-sm mb-0">

                                        <thead>

                                            <tr>

                                                <th rowspan="2">
                                                    Utility
                                                </th>

                                                <th colspan="2"
                                                    class="text-center">
                                                    ALLIED
                                                </th>

                                                <th colspan="2"
                                                    class="text-center">
                                                    KIMBAL
                                                </th>

                                                <th rowspan="2"
                                                    class="text-end">
                                                    TOTAL
                                                </th>

                                            </tr>

                                            <tr>

                                                <th class="text-end">
                                                    1PH
                                                </th>

                                                <th class="text-end">
                                                    3PH
                                                </th>

                                                <th class="text-end">
                                                    1PH
                                                </th>

                                                <th class="text-end">
                                                    3PH
                                                </th>

                                            </tr>

                                        </thead>

                                        <tbody>

                                            <tr>

                                                <td class="fw-semibold">
                                                    BRPL
                                                </td>

                                                <td class="text-end"
                                                    id="brplAllied1Ph">
                                                    0
                                                </td>

                                                <td class="text-end"
                                                    id="brplAllied3Ph">
                                                    0
                                                </td>

                                                <td class="text-end"
                                                    id="brplKimbal1Ph">
                                                    0
                                                </td>

                                                <td class="text-end"
                                                    id="brplKimbal3Ph">
                                                    0
                                                </td>

                                                <td class="text-end fw-bold"
                                                    id="brplTotalMeter">
                                                    0
                                                </td>

                                            </tr>

                                        </tbody>

                                    </table>

                                </div>

                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-12">

                                <div class="meter-chart-item brpl-only-chart">

                                    <div class="meter-chart-title">
                                        BRPL
                                    </div>

                                    <div class="meter-chart-wrapper">
                                        <canvas id="brplMeterTypeChart"></canvas>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="col-xl-6 col-lg-6 col-md-12">

                <div class="card dashboard-card h-100">

                    <div class="card-header">

                        <i class="bi bi-download me-1"></i>

                        Meter Received in MRO

                    </div>


                    <div class="card-body">

                        <!-- ================================
                     BRPL ONLY
                ================================= -->

                        <div class="mro-company-row brpl-only-mro">

                            <!-- COMPANY -->
                            <div class="mro-company">

                                <span class="company-badge brpl-badge">
                                    BRPL
                                </span>

                            </div>


                            <!-- DOWNLOAD -->
                            <div class="mro-metric">

                                <div class="mro-label">
                                    Download
                                </div>

                                <div class="mro-value text-success">

                                    <a href="javascript:void(0)"
                                       class="text-success"
                                       style="text-decoration:none;"
                                       id="hesDownload">

                                        0

                                    </a>

                                    <small id="downloadPercentage">
                                        (0%)
                                    </small>

                                </div>

                            </div>


                            <!-- FAILED -->
                            <div class="mro-metric">

                                <div class="mro-label">
                                    Failed
                                </div>

                                <div class="mro-value">

                                    <a href="javascript:void(0)"
                                       class="mro-link mro-failed-value"
                                       id="downloadFailed">

                                        0

                                    </a>

                                    <small id="failedPercentage">
                                        (0%)
                                    </small>

                                </div>

                            </div>


                            <!-- TOTAL -->
                            <div class="mro-metric">

                                <div class="mro-label">
                                    Total
                                </div>

                                <div class="mro-value"
                                     id="totalMeters">

                                    0

                                </div>

                            </div>


                            <!-- BILLED -->
                            <div class="mro-metric">

                                <div class="mro-label">
                                    Billed
                                </div>

                                <div class="mro-value text-primary">

                                    <span id="billedMeters">
                                        0
                                    </span>

                                    <small id="billedPercentage">
                                        (0%)
                                    </small>

                                </div>

                            </div>


                            <!-- BILLED FAILED -->
                            <div class="mro-metric">

                                <div class="mro-label">
                                    Billed Failed
                                </div>

                                <div class="mro-value">

                                    <a href="javascript:void(0)"
                                       class="mro-link mro-failed-value"
                                       id="billedFailed">

                                        0

                                    </a>

                                    <small id="billedFailedPercentage">
                                        (0%)
                                    </small>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
     BRPL DASHBOARD CHARTS
========================================================= -->

        <div class="row g-3 mt-1">

            <!-- DEPARTMENT DISTRIBUTION -->
            <div class="col-xl-6 col-lg-6 col-md-12">

                <div class="card dashboard-card h-100">

                    <div class="card-header">

                        <i class="bi bi-bar-chart-fill me-1"></i>

                        Department Distribution

                    </div>

                    <div class="card-body chart-card-body">

                        <div class="dashboard-chart-container">
                            <canvas id="departmentChart"></canvas>
                        </div>

                    </div>

                </div>

            </div>


            <!-- FAILURE REASON -->
            <div class="col-xl-6 col-lg-6 col-md-12">

                <div class="card dashboard-card h-100">

                    <div class="card-header">

                        <i class="bi bi-exclamation-triangle-fill me-1"></i>

                        Failure Reason Summary

                    </div>

                    <div class="card-body chart-card-body">

                        <div class="dashboard-chart-container">
                            <canvas id="readingTrendChart"></canvas>
                        </div>

                    </div>

                </div>

            </div>

        </div>

</div>

</div>

<!-- HES DOWNLOAD SUMMARY MODAL -->
<div class="modal fade"
     id="HesDownloadSummaryModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="HesdownloadSummaryModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl" role="document">

        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">

                <h5 class="modal-title"
                    id="HesdownloadSummaryModalLabel">
                    Meter Download Summary
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- BODY -->
            <div class="modal-body">

                <!-- FILTER SECTION -->
                <div class="filter-section">

                    <div class="row align-items-end g-2">

                        <!-- DEPARTMENT -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label fw-bold">
                                Department
                            </label>

                            <select id="hesDepartmentFilter"
                                    class="form-select">

                                <option value="">
                                    All Departments
                                </option>

                            </select>

                        </div>


                        <!-- DIVISION -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label fw-bold">
                                Division
                            </label>

                            <select id="hesDivisionFilter"
                                    class="form-select">

                                <option value="">
                                    All Divisions
                                </option>

                            </select>

                        </div>


                        <!-- PHASE -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label fw-bold">
                                Phase
                            </label>

                            <select id="hesPhaseFilter"
                                    class="form-select">

                                <option value="">
                                    All Phases
                                </option>

                            </select>

                        </div>


                        <!-- METER MAKE -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label fw-bold">
                                Meter Make
                            </label>

                            <select id="hesMeterMakeFilter"
                                    class="form-select">

                                <option value="">
                                    All Meter Makes
                                </option>

                            </select>

                        </div>


                        <!-- BUTTONS -->
                        <div class="col-12 d-flex justify-content-between align-items-center mt-2">

                            <!-- CLEAR -->
                            <button type="button"
                                    id="btnClearHesDownloadFilters"
                                    class="btn btn-outline-secondary">

                                <i class="bi bi-x-circle"></i>
                                Clear Filters

                            </button>


                            <!-- EXPORT -->
                            <div class="export-buttons">

                                <button type="button"
                                        class="btn btn-success"
                                        onclick="exportHesDownloadBrplTableToExcel()">

                                    <i class="bi bi-file-earmark-excel"></i>
                                    Excel

                                </button>


                                <button type="button"
                                        class="btn btn-primary"
                                        onclick="exportHesDownloadBrplTableToCSV()">

                                    <i class="bi bi-file-earmark-csv"></i>
                                    CSV

                                </button>


                                <button type="button"
                                        class="btn btn-secondary"
                                        onclick="window.print()">

                                    <i class="bi bi-printer"></i>
                                    Print

                                </button>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- TABLE -->
                <div class="table-responsive hes-download-table-wrapper">

                    <table id="hesDownloadSummaryTable"
                           class="table table-bordered custom-table">

                        <thead>

                            <tr>

                                <th>S.No.</th>

                                <th>Cons Ref</th>

                                <th>Meter Number</th>

                                <th>Phase</th>

                                <th>Department</th>

                                <th>Division</th>

                                <th>Seq No</th>

                                <th>Address</th>

                                <th>Meter Make</th>

                            </tr>

                        </thead>


                        <tbody id="hesDownloadSummaryBody">
                        </tbody>

                    </table>

                </div>

            </div>


            <!-- FOOTER -->
            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>

