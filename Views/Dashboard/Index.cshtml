   <!-- Modal for Detailed Summary -->
<div class="modal fade"
     id="downloadSummaryModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="downloadSummaryModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl" role="document">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="downloadSummaryModalLabel">
                    Meter Download Detailed Summary
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <!-- Filter Section -->
                <div class="filter-section">

                    <div class="row align-items-end g-2">

                        <!-- Department -->
                        <div class="col-lg-2 col-md-4">

                            <label class="form-label fw-bold">
                                Department
                            </label>

                            <select id="departmentFilter"
                                    class="form-select">

                                <option value="">
                                    All Departments
                                </option>

                            </select>

                        </div>

                        <!-- Failed Reason -->
                        <div class="col-lg-2 col-md-4">

                            <label class="form-label fw-bold">
                                Failed Reason
                            </label>

                            <select id="reasonFilter"
                                    class="form-select">

                                <option value="">
                                    All Reasons
                                </option>

                            </select>

                        </div>


                        <!-- Phase -->
                        <div class="col-lg-2 col-md-4">

                            <label class="form-label fw-bold">
                                Phase
                            </label>

                            <select id="phaseFilter"
                                    class="form-select">

                                <option value="">
                                    All Phases
                                </option>

                            </select>

                        </div>


                        <!-- Meter Make -->
                        <div class="col-lg-2 col-md-4">

                            <label class="form-label fw-bold">
                                Meter Make
                            </label>

                            <select id="meterMakeFilter"
                                    class="form-select">

                                <option value="">
