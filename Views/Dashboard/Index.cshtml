
 <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
<div id="dashboardSkeleton">

    <!-- Skeleton cards -->
    <div class="row g-3">

        <div class="col-lg-4">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-line mt-3"></div>
                <div class="skeleton skeleton-line"></div>
                <div class="skeleton skeleton-circle mx-auto mt-3"></div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-table mt-3"></div>
            </div>
        </div>

    </div>

    <div class="row mt-3">

        <div class="col-lg-6">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-chart mt-3"></div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card p-3">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-chart mt-3"></div>
            </div>
        </div>

    </div>

</div>

<div id="dashboardContent" style="display:none;">

  <div class="container-fluid py-3">
        <div class="card border-0 shadow-sm mb-3 filter-toolbar">
            <div class="card-body py-2">

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">

                    <div class="d-flex align-items-center gap-3">

                        <div class="fw-semibold text-primary">
                            <i class="bi bi-calendar3"></i>
                            Reading Month
                        </div>

                        <input type="month"
                               id="readingMonth"
                               class="form-control form-control-sm"
                               style="width:160px;" />

                        <button class="btn btn-primary btn-sm px-3"
                                id="btnLoadDashboard">
                            <i class="bi bi-search"></i>
                            Apply
                        </button>

                    </div>

                   

                </div>

            </div>
        </div>
    <!-- Top Row -->
    <div class="row g-3 ">
            <!-- Meter Summary -->
            <div class="col-lg-4">

                <div class="card dashboard-card h-100">

                    <div class="card-header">
                        <i class="bi bi-speedometer2"></i>
                        Meter Summary
                    </div>

                    <div class="card-body">

                        <div class="row align-items-center">

                            <div class="col-6">

                                <table class="table table-sm table-borderless mb-0">

                                    <tbody>

                                        <tr>
                                            <td>Allied</td>
                                            <td class="fw-bold text-primary text-end"
                                                id="alliedCount">
                                                0
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>Kimbal</td>
                                            <td class="fw-bold text-success text-end"
                                                id="kimbalCount">
                                                0
                                            </td>
                                        </tr>

                                        <tr class="border-top">
                                            <th>Total</th>
                                            <th class="text-end"
                                                id="totalMeter">0</th>
                                        </tr>

                                    </tbody>

                                </table>

                            </div>

                            <div class="col-6">

                                <canvas id="meterTypeChart"
                                        height="220"></canvas>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        <!-- Meter Received -->
        <div class="col-lg-8">

            <div class="card dashboard-card h-100">

                <div class="card-header">
                    <i class="bi bi-download"></i>
                    Meter Received in MRO
                </div>

                <div class="card-body d-flex flex-column justify-content-center">

                    <div class="d-flex justify-content-between align-items-center mb-2">

                        <small class="text-muted">
                            Till Date <span id="summaryDate"></span>
                        </small>

                        <button class="btn btn-sm btn-primary"
                                id="btnViewDownloadDetails">
                            <i class="bi bi-table"></i> View Details
                        </button>

                    </div>

                    <table class="table table-borderless text-center align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Total</th>
                                <th>HES Download</th>
                                <th>Download Failed</th>
                                <th>Download %</th>
                                <th>Failed %</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td class="fw-bold fs-2" id="totalMeters">0</td>

                                <td class="fw-bold fs-2 text-success" id="hesDownload">0</td>

                                <td class="fw-bold fs-2 text-danger" id="downloadFailed">0</td>

                                <td class="fw-bold fs-2 text-primary" id="downloadPercentage">0%</td>

                                    <td class="fw-bold fs-2 text-danger" id="failedPercentage">0%</td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

    <!-- Charts -->

    <div class="row mt-3 g-2">

        <div class="col-lg-6">

            <div class="card dashboard-card">

                <div class="card-header">
                    Department Distribution
                </div>

                <div class="card-body">

                    <canvas id="departmentChart"
                            ></canvas>

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card dashboard-card">

                <div class="card-header">
                    Reading Trend
                </div>

                <div class="card-body">

                    <canvas id="readingTrendChart"
                           ></canvas>

                </div>

            </div>

        </div>

    </div>

</div>

</div>

@* detailed summary  *@
<div class="modal fade"
     id="downloadSummaryModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Meter Download Detailed Summary
                </h5>

                <button class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <div class="row mb-3">

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Department</label>
                        <select id="departmentFilter" class="form-select">
                            <option value="">All Departments</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Status</label>
                        <select id="statusFilter" class="form-select">
                            <option value="">All Status</option>
                        </select>
                    </div>

                </div>

                <table id="downloadSummaryTable"
                       class="table table-bordered table-striped table-hover w-100">

                    <thead class="table-light">

                        <tr>
                            <th>Consumer No</th>
                            <th>Meter No</th>
                            <th>Division</th>
                            <th>Department</th>
                            <th>Meter Type</th>
                            <th>Status</th>
                            <th>Reason</th>
                            <th>Entry Date</th>
                        </tr>

                    </thead>

                </table>

            </div>

        </div>

    </div>

</div>
<!-- 1. jQuery FIRST -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- 3. DataTables -->
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>

<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script>
     let downloadTable = null;

// Department Filter
$(document).on("change", "#departmentFilter", function () {

    if (!downloadTable) return;

    downloadTable
        .column(3)   // Department
        .search($(this).val() ? '^' + $(this).val() + '$' : '', true, false)
        .draw();
});

// Status Filter
$(document).on("change", "#statusFilter", function () {

    if (!downloadTable) return;

    downloadTable
        .column(5)   // Status
        .search($(this).val() ? '^' + $(this).val() + '$' : '', true, false)
        .draw();
});

// View Details
$("#btnViewDownloadDetails").on("click", function () {

    const modal = new bootstrap.Modal(
        document.getElementById("downloadSummaryModal")
    );

    modal.show();

    if ($.fn.DataTable.isDataTable("#downloadSummaryTable")) {

        downloadTable.ajax.reload(null, false);

        setTimeout(function () {
            downloadTable.columns.adjust().responsive.recalc();
        }, 200);

        return;
    }

    downloadTable = $("#downloadSummaryTable").DataTable({

        processing: true,
        destroy: true,
        responsive: true,
        autoWidth: false,

        ajax: {
            url: "/api/dashboardapi/meter-download-detailed-summary",
            data: function () {
            return {
            readingMonth: getReadingMonth()
            };
        },
        dataSrc: ""
        },

        columns: [

            {
                data: "consRef",
                width: "14%"
            },

            {
                data: "meterNumber",
                width: "12%"
            },

            {
                data: "sapDivision",
                width: "10%",
                className: "text-center"
            },

            {
                data: "sapDepartment",
                width: "10%"
            },

            {
                data: "meterType",
                width: "10%",
                className: "text-center"
            },

            {
                data: "status",
                width: "10%",
                className: "text-center",

                render: function (data) {

                    if (data === "Download") {
                        return '<span class="badge bg-success">Download</span>';
                    }

                    if (data === "Failed") {
                        return '<span class="badge bg-danger">Failed</span>';
                    }

                    return '<span class="badge bg-secondary">' + data + '</span>';
                }
            },

            {
                data: "schedulerMessage",
                width: "24%",

                render: function (data) {
                    return data ?? '<span class="text-muted">--</span>';
                }
            },

            {
                data: "entryDate",
                width: "12%",
                className: "text-center",

                render: function (data) {

                    if (!data)
                        return "--";

                    return new Date(data).toLocaleString("en-GB");
                }
            }

        ],

        pageLength: 25,

        scrollX: true,
        scrollY: "500px",
        scrollCollapse: true,

        fixedHeader: true,

        dom:
            "<'row mb-3'<'col-md-8'B><'col-md-4'f>>" +
            "rt" +
            "<'row mt-2'<'col-md-6'i><'col-md-6'p>>",

        buttons: [

            {
                extend: "copy",
                className: "btn btn-secondary btn-sm"
            },

            {
                extend: "excel",
                className: "btn btn-success btn-sm",
                title: "Meter Download Detailed Summary"
            },

            {
                extend: "csv",
                className: "btn btn-info btn-sm",
                title: "Meter Download Detailed Summary"
            },

            {
                extend: "print",
                className: "btn btn-primary btn-sm",
                title: "Meter Download Detailed Summary"
            }

        ],

    initComplete: function () {

    const api = this.api();

    // Department dropdown
    const dept = $("#departmentFilter");
    dept.empty().append('<option value="">All Departments</option>');

    api.column(3).data().unique().sort().each(function (d) {
    dept.append('<option value="' + d + '">' + d + '</option>');
    });

    // Status dropdown
    const status = $("#statusFilter");
    status.empty().append('<option value="">All Status</option>');

    api.column(5).data().unique().sort().each(function (d) {
    status.append('<option value="' + d + '">' + d + '</option>');
    });

    // Default to Failed
    status.val("Failed");

    api.column(5)
    .search("^Failed$", true, false)
    .draw();
    }

    });

});

// Fix columns after modal opens
$('#downloadSummaryModal').on('shown.bs.modal', function () {

    if (downloadTable) {
        downloadTable.columns.adjust().responsive.recalc();
    }

});
</script>


