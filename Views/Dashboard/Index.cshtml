<!-- HES DOWNLOAD SUMMARY MODAL -->
<div class="modal fade"
     id="HesDownloadSummaryModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="HesdownloadSummaryModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl" role="document">

        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">

                <h5 class="modal-title"
                    id="HesdownloadSummaryModalLabel">
                    Meter Download Summary
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- BODY -->
            <div class="modal-body">

                <!-- FILTER SECTION -->
                <div class="filter-section">

                    <div class="row align-items-end g-2">

                        <!-- DEPARTMENT -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label fw-bold">
                                Department
                            </label>

                            <select id="hesDepartmentFilter"
                                    class="form-select">

                                <option value="">
                                    All Departments
                                </option>

                            </select>

                        </div>


                        <!-- DIVISION -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label fw-bold">
                                Division
                            </label>

                            <select id="hesDivisionFilter"
                                    class="form-select">

                                <option value="">
                                    All Divisions
                                </option>

                            </select>

                        </div>


                        <!-- PHASE -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label fw-bold">
                                Phase
                            </label>

                            <select id="hesPhaseFilter"
                                    class="form-select">

                                <option value="">
                                    All Phases
                                </option>

                            </select>

                        </div>


                        <!-- METER MAKE -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label fw-bold">
                                Meter Make
                            </label>

                            <select id="hesMeterMakeFilter"
                                    class="form-select">

                                <option value="">
                                    All Meter Makes
                                </option>

                            </select>

                        </div>


                        <!-- BUTTONS -->
                        <div class="col-12 d-flex justify-content-between align-items-center mt-2">

                            <!-- CLEAR -->
                            <button type="button"
                                    id="btnClearHesDownloadFilters"
                                    class="btn btn-outline-secondary">

                                <i class="bi bi-x-circle"></i>
                                Clear Filters

                            </button>


                            <!-- EXPORT -->
                            <div class="export-buttons">

                                <button type="button"
                                        class="btn btn-success"
                                        onclick="exportHesDownloadBrplTableToExcel()">

                                    <i class="bi bi-file-earmark-excel"></i>
                                    Excel

                                </button>


                                <button type="button"
                                        class="btn btn-primary"
                                        onclick="exportHesDownloadBrplTableToCSV()">

                                    <i class="bi bi-file-earmark-csv"></i>
                                    CSV

                                </button>


                                <button type="button"
                                        class="btn btn-secondary"
                                        onclick="window.print()">

                                    <i class="bi bi-printer"></i>
                                    Print

                                </button>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- TABLE -->
                <div class="table-responsive hes-download-table-wrapper">

                    <table id="hesDownloadSummaryTable"
                           class="table table-bordered custom-table">

                        <thead>

                            <tr>

                                <th>S.No.</th>

                                <th>Cons Ref</th>

                                <th>Meter Number</th>

                                <th>Phase</th>

                                <th>Department</th>

                                <th>Division</th>

                                <th>Seq No</th>

                                <th>Address</th>

                                <th>Meter Make</th>

                            </tr>

                        </thead>


                        <tbody id="hesDownloadSummaryBody">
                        </tbody>

                    </table>

                </div>

            </div>


            <!-- FOOTER -->
            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>

