<script>
    let allDownloadData = [];
    let filteredData = [];

    // Open Modal
    $("#btnViewDownloadDetails").on("click", function () {
    const modal = new bootstrap.Modal(
    document.getElementById("downloadSummaryModal")
    );
    modal.show();
    loadDownloadSummary();
    });

    // Load Data from API
    async function loadDownloadSummary() {
    try {
    $("#downloadSummaryBody").html(`
    <tr>
    <td colspan="9" class="text-center py-4">
    <div class="spinner-border spinner-border-sm text-primary"></div>
    Loading...
    </td>
    </tr>
    `);

      const response = await fetch(
        `${getApiUrl("dashboardapi/meter-download-detailed-summary")}?readingMonth=${encodeURIComponent(getReadingMonth())}`
      );

    if (!response.ok) {
    throw new Error("Unable to load data");
    }

    allDownloadData = await response.json();
    filteredData = [...allDownloadData];

    loadDepartmentFilter();
    loadReasonFilter();
    renderTable(filteredData);

    } catch (err) {
    console.error(err);
    $("#downloadSummaryBody").html(`
    <tr>
    <td colspan="9" class="text-center text-danger">
    Failed to load data. Error: ${err.message}
    </td>
    </tr>
    `);
    }
    }

    // Get Reading Month (current month or customize as needed)
    function getReadingMonth() {
    const now = new Date();
    return now.getFullYear() + "-" + String(now.getMonth() + 1).padStart(2, "0");
    }

    // Department Dropdown
    function loadDepartmentFilter() {
    const ddl = $("#departmentFilter");
    ddl.empty();
    ddl.append(`<option value="">All Departments</option>`);

    const departments = [...new Set(
    allDownloadData
    .map(x => x.sapDepartment)
    .filter(x => x)
    )].sort();

    departments.forEach(d => {
    ddl.append(`<option value="${d}">${d}</option>`);
    });
    }

    // Reason Dropdown
    function loadReasonFilter() {
    const ddl = $("#reasonFilter");
    ddl.empty();
    ddl.append(`<option value="">All Reasons</option>`);
    ddl.append(`<option value="SYSTEM TITLE">System Title Mismatch</option>`);
    ddl.append(`<option value="TCP">TCP Connection Failed</option>`);
    ddl.append(`<option value="NO DATA">No Data Found ODR</option>`);
    ddl.append(`<option value="TIMEOUT">Timeout</option>`);
    ddl.append(`<option value="OTHER">Other</option>`);
    }

    // Filter Events
    $("#departmentFilter").on("change", applyFilters);
    $("#reasonFilter").on("change", applyFilters);

    // Apply Filters
    function applyFilters() {
    const department = ($("#departmentFilter").val() || "").toUpperCase();
    const reason = ($("#reasonFilter").val() || "").toUpperCase();

    filteredData = allDownloadData.filter(item => {
    const deptMatch =
    department === "" ||
    (item.sapDepartment || "").toUpperCase() === department;

    let reasonMatch = true;
    const msg = (item.schedulerMessage || "").toUpperCase();

    if (reason !== "") {
    if (reason === "OTHER") {
    reasonMatch =
    !msg.includes("SYSTEM TITLE") &&
    !msg.includes("TCP") &&
    !msg.includes("NO DATA") &&
    !msg.includes("TIMEOUT");
    } else {
    reasonMatch = msg.includes(reason);
    }
    }

    return deptMatch && reasonMatch;
    });

    renderTable(filteredData);
    }

    // Render Table
    function renderTable(data) {
    const tbody = $("#downloadSummaryBody");
    tbody.empty();

    if (data.length === 0) {
    tbody.html(`
    <tr>
    <td colspan="11" class="text-center">
    No Records Found
    </td>
    </tr>
    `);
    return;
    }

data.forEach((x, index) => {

    let badgeColor = "#6c757d";
    let textColor = "#fff";

    const msg = (x.schedulerMessage || "").toUpperCase();

    if (msg.includes("SYSTEM TITLE")) {
        badgeColor = "#dc3545";
    }
    else if (msg.includes("TCP")) {
        badgeColor = "#fd7e14";
    }
    else if (msg.includes("NO DATA")) {
        badgeColor = "#ffc107";
        textColor = "#000";
    }
    else if (msg.includes("TIMEOUT")) {
        badgeColor = "#6c757d";
    }

    const entryDate = x.entryDate
        ? new Date(x.entryDate).toLocaleString("en-GB")
        : "--";

    tbody.append(`
        <tr>

            <!-- S.No -->
            <td class="text-center fw-semibold">
                ${index + 1}
            </td>

            <td>${x.consRef ?? ""}</td>

            <td>${x.meterNumber ?? ""}</td>

            <td>${x.phase ?? ""}</td>

            <td>${x.sapDepartment ?? ""}</td>

            <td>${x.sapDivision ?? ""}</td>

            <td>${x.sapSeqNo ?? ""}</td>

            <td>${x.address ?? "--"}</td>

            <td>${x.meterType ?? ""}</td>

            <td>
                <span class="badge"
                    style="
                        background:${badgeColor};
                        color:${textColor};
                    ">
                    ${x.schedulerMessage ?? "--"}
                </span>
            </td>

            <td>${entryDate}</td>

        </tr>
    `);
});
    }

