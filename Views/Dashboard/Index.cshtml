    </div>

</div>

<div id="dashboardContent" style="display:none;">

  <div class="container-fluid py-1">   
        <div class="row g-3">
            <div class="col-lg-6">

                <div class="card dashboard-card meter-summary-card h-100">

                    <div class="card-header">
                        <i class="bi bi-speedometer2"></i>
                        Meter Summary
                    </div>

                    <div class="card-body">

                        <div class="row g-2 align-items-center">

                            <div class="col-md-7">

                                <div class="meter-summary-table">

                                    <table class="table table-sm mb-0">

                                        <thead>
                                            <tr>

                                                <th rowspan="2">
                                                    Utility
                                                </th>

                                                <th colspan="2"
