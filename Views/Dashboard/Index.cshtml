    //BYPL
    // ============================================================
// BYPL - HES FAILED DETAILED SUMMARY
// ============================================================

let allDownloadDataBypl = [];
let filteredDataBypl = [];


// ============================================================
// OPEN MODAL
// ============================================================

$("#btnViewHesFailedDetails").on("click", function () {

    const modal = new bootstrap.Modal(
        document.getElementById("downloadSummaryModalBYPL")
    );

    modal.show();

    loadDownloadSummaryBYPL();
});


// ============================================================
// LOAD DATA FROM API
// ============================================================

async function loadDownloadSummaryBYPL() {

    try {

        $("#downloadSummaryBodyBYPL").html(`
            <tr>
                <td colspan="11" class="text-center py-4">

                    <div class="spinner-border spinner-border-sm text-primary"></div>

                    Loading...

                </td>
            </tr>
        `);


        const response = await fetch(
            "/api/dashboardapi/meter-download-detailed-summary-bypl?readingMonth="
            + encodeURIComponent(getReadingMonth())
        );


        if (!response.ok) {
            throw new Error("Unable to load data");
        }


        allDownloadDataBypl = await response.json();

        filteredDataBypl = [...allDownloadDataBypl];


        loadDepartmentFilterBYPL();

        loadReasonFilterBYPL();

        renderTableBYPL(filteredDataBypl);


    }
    catch (err) {

        console.error(err);


        $("#downloadSummaryBodyBYPL").html(`
            <tr>
                <td colspan="11"
                    class="text-center text-danger py-4">

                    Failed to load data.
                    Error: ${err.message}

                </td>
            </tr>
        `);
    }
}


// ============================================================
// GET READING MONTH
// ============================================================

function getReadingMonth() {

    const now = new Date();

    return now.getFullYear()
        + "-"
        + String(now.getMonth() + 1).padStart(2, "0");
}


// ============================================================
// DEPARTMENT FILTER
// ============================================================

function loadDepartmentFilterBYPL() {

    const ddl = $("#departmentFilterBYPL");

    ddl.empty();

    ddl.append(`
        <option value="">
            All Departments
        </option>
    `);


    const departments = [
        ...new Set(
            allDownloadDataBypl
                .map(x => x.sapDepartment)
                .filter(x => x)
        )
    ].sort();


    departments.forEach(department => {

        ddl.append(`
            <option value="${escapeHtml(department)}">
                ${escapeHtml(department)}
            </option>
        `);

    });
}


// ============================================================
// FAILED REASON FILTER
// ============================================================

function loadReasonFilterBYPL() {

    const ddl = $("#reasonFilterBYPL");

    ddl.empty();

    ddl.append(`
        <option value="">
            All Reasons
        </option>
    `);

    ddl.append(`
        <option value="SYSTEM TITLE">
            System Title Mismatch
        </option>
    `);

    ddl.append(`
        <option value="TCP">
            TCP Connection Failed
        </option>
    `);

    ddl.append(`
        <option value="NO DATA">
            No Data Found ODR
        </option>
    `);

    ddl.append(`
        <option value="TIMEOUT">
            Timeout
        </option>
    `);

    ddl.append(`
        <option value="OTHER">
            Other
        </option>
    `);
}


// ============================================================
// FILTER EVENTS
// ============================================================

$("#departmentFilterBYPL").on(
    "change",
    applyFiltersBYPL
);


$("#reasonFilterBYPL").on(
    "change",
    applyFiltersBYPL
);


// ============================================================
// APPLY FILTERS
// ============================================================

function applyFiltersBYPL() {

    const department =
        ($("#departmentFilterBYPL").val() || "")
            .toUpperCase();


    const reason =
        ($("#reasonFilterBYPL").val() || "")
            .toUpperCase();


    filteredDataBypl = allDownloadDataBypl.filter(item => {


        // ----------------------------------------
        // Department
        // ----------------------------------------

        const itemDepartment =
            (item.sapDepartment || "")
                .toUpperCase();


        const departmentMatch =
            department === ""
            || itemDepartment === department;


        // ----------------------------------------
        // Failure Reason
        // ----------------------------------------

        const message =
            (item.schedulerMessage || "")
                .toUpperCase();


        let reasonMatch = true;


        if (reason !== "") {

            if (reason === "OTHER") {

                reasonMatch =
                    !message.includes("SYSTEM TITLE")
                    && !message.includes("TCP")
                    && !message.includes("NO DATA")
                    && !message.includes("TIMEOUT");

            }
            else {

                reasonMatch =
                    message.includes(reason);

            }
        }


        return departmentMatch && reasonMatch;

    });


    renderTableBYPL(filteredDataBypl);
}


// ============================================================
// RENDER TABLE
// ============================================================

function renderTableBYPL(data) {

    const tbody =
        $("#downloadSummaryBodyBYPL");


    tbody.empty();


    // ----------------------------------------
    // NO RECORDS
    // ----------------------------------------

    if (!data || data.length === 0) {

        tbody.html(`
            <tr>

                <td colspan="11"
                    class="text-center py-4">

                    No Records Found

                </td>

            </tr>
        `);

        return;
    }


    // ----------------------------------------
    // DATA
    // ----------------------------------------

    data.forEach((x, index) => {


        // ----------------------------------------
        // STATUS BADGE
        // ----------------------------------------

        let badgeColor = "#6c757d";
        let textColor = "#fff";


        const message =
            (x.schedulerMessage || "")
                .toUpperCase();


        if (message.includes("SYSTEM TITLE")) {

            badgeColor = "#dc3545";

        }
        else if (message.includes("TCP")) {

            badgeColor = "#fd7e14";

        }
        else if (message.includes("NO DATA")) {

            badgeColor = "#ffc107";
            textColor = "#000";

        }
        else if (message.includes("TIMEOUT")) {

            badgeColor = "#6c757d";

        }


        // ----------------------------------------
        // ENTRY DATE
        // ----------------------------------------

        const entryDate = x.entryDate
            ? new Date(x.entryDate)
                .toLocaleString("en-GB", {
                    day: "2-digit",
                    month: "2-digit",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit"
                })
            : "--";


        // ----------------------------------------
        // ROW
        // ----------------------------------------

        tbody.append(`

            <tr>

                <!-- 1. S.NO -->
                <td class="text-center">
                    ${index + 1}
                </td>


                <!-- 2. CONS REF -->
                <td>
                    ${escapeHtml(x.consRef)}
                </td>


                <!-- 3. METER NUMBER -->
                <td>
                    ${escapeHtml(x.meterNumber)}
                </td>


                <!-- 4. PHASE -->
                <td class="text-center">
                    ${escapeHtml(x.phase)}
                </td>


                <!-- 5. DEPARTMENT -->
                <td>
                    ${escapeHtml(x.sapDepartment)}
                </td>


                <!-- 6. DIVISION -->
                <td>
                    ${escapeHtml(x.sapDivision)}
                </td>


                <!-- 7. SEQ NO -->
                <td>
                    ${escapeHtml(x.sapSeqNo)}
                </td>


                <!-- 8. ADDRESS -->
                <td class="address-cell">
                    ${escapeHtml(x.address || "--")}
                </td>


                <!-- 9. METER MAKE -->
                <td class="text-center">
                    ${escapeHtml(x.meterType)}
                </td>


                <!-- 10. STATUS -->
                <td class="status-cell">

                    <span class="badge"
                          style="
                              background:${badgeColor};
                              color:${textColor};
                              white-space:normal;
                              display:inline-block;
                              line-height:1.2;
                          ">

                        ${escapeHtml(
                            x.schedulerMessage || "--"
                        )}

                    </span>

                </td>


                <!-- 11. ENTRY DATE -->
                <td class="text-center">
                    ${entryDate}
                </td>

            </tr>

        `);

    });
}


// ============================================================
// HTML ENCODE
// Prevent HTML breaking because address/reason may contain
// special characters.
// ============================================================

function escapeHtml(value) {

    if (value === null || value === undefined) {
        return "";
    }


    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


