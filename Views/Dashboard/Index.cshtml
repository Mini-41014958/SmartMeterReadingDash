    // ============================================================
    // METER MAKE FILTER
    // ============================================================

    function loadMeterMakeFilterBYPL() {

        const ddl =
            $("#meterMakeFilterBYPL");


        ddl.empty();


        ddl.append(`
            <option value="">
                All Meter Makes
            </option>
        `);


        const meterMakes = [
            ...new Set(
