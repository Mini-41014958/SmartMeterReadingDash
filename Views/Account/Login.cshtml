@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Login - RCM Smart Meter Reading Dashboard
    </title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/Auth.css"
          asp-append-version="true" />

</head>

<body>

    <!-- =========================================================
         BACKGROUND
         ========================================================= -->

    <div class="page-background">

        <div class="background-grid"></div>

        <div class="glow glow-one"></div>
        <div class="glow glow-two"></div>

        <div class="floating-circle circle-one"></div>
        <div class="floating-circle circle-two"></div>

    </div>


    <!-- =========================================================
         LOGIN PAGE
         ========================================================= -->

    <main class="auth-page">

        <div class="auth-container">


            <!-- =================================================
                 LEFT BRAND PANEL
                 ================================================= -->

            <section class="brand-panel">

                <div class="brand-content">

                    <div class="brand-top">

                        <div class="brand-logo-wrapper">

                            <img src="~/images/bses-logo.png"
                                 alt="BSES Logo"
                                 class="auth-logo" />

                        </div>

                    </div>


                    <div class="brand-heading">

                        <span class="brand-eyebrow">
                            RCM OPERATIONS
                        </span>

                        <h1>
                            Smart Meter
                            <span>Reading</span>
                        </h1>

                        <p>
                            Monitor, analyze and manage smart meter
                            reading operations from a single dashboard.
                        </p>

                    </div>


                    <div class="brand-features">

                        <div class="feature-item">

                            <div class="feature-icon">
                                <svg viewBox="0 0 24 24">
                                    <path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6L5.6 18.4" />
                                </svg>
                            </div>

                            <div>
                                <strong>
                                    Real-time Monitoring
                                </strong>

                                <span>
                                    Track meter reading performance
                                </span>
                            </div>

                        </div>


                        <div class="feature-item">

                            <div class="feature-icon">
                                <svg viewBox="0 0 24 24">
                                    <path d="M4 19V5M4 19h16" />
                                    <path d="M7 16l4-5 3 3 5-7" />
                                </svg>
                            </div>

                            <div>
                                <strong>
                                    Operational Insights
                                </strong>

                                <span>
                                    Analyze failures and reading trends
                                </span>
                            </div>

                        </div>


                        <div class="feature-item">

                            <div class="feature-icon">
                                <svg viewBox="0 0 24 24">
                                    <rect x="5"
                                          y="10"
                                          width="14"
                                          height="10"
                                          rx="2" />

                                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                </svg>
                            </div>

                            <div>
                                <strong>
                                    Secure Access
                                </strong>

                                <span>
                                    Protected enterprise dashboard
                                </span>
                            </div>

                        </div>

                    </div>


                    <div class="brand-footer">

                        <span>
                            RCM Smart Meter Platform
                        </span>

                        <span class="footer-divider"></span>

                        <span>
                            v1.0
                        </span>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 LOGIN CARD
                 ================================================= -->

            <section class="login-panel">

                <div class="auth-card">


                    <!-- HEADER -->

                    <div class="auth-brand">

                        <div class="mobile-logo">

                            <img src="~/images/bses-logo.png"
                                 alt="BSES Logo" />

                        </div>

                        <span class="login-label">
                            SECURE LOGIN
                        </span>

                        <h2>
                            Welcome back
                        </h2>

                        <p>
                            Sign in to continue to your dashboard
                        </p>

                    </div>


                    <!-- ERROR -->

                    <div id="loginError"
                         class="auth-message error"
                         style="display:none;">
                    </div>


                    <!-- FORM -->

                    <form id="loginForm"
                          autocomplete="off">


                        <!-- USERNAME -->

                        <div class="form-group">

                            <label for="username">
                                Username
                            </label>

                            <div class="input-wrapper">

                                <svg class="input-icon"
                                     viewBox="0 0 24 24">

                                    <path d="M20 21a8 8 0 0 0-16 0" />

                                    <circle cx="12"
                                            cy="7"
                                            r="4" />

                                </svg>

                                <input type="text"
                                       id="username"
                                       name="username"
                                       placeholder="Enter your username"
                                       autocomplete="username"
                                       maxlength="100"
                                       required />

                            </div>

                        </div>


                        <!-- PASSWORD -->

                        <div class="form-group">

                            <div class="label-row">

                                <label for="password">
                                    Password
                                </label>

                            </div>

                            <div class="input-wrapper">

                                <svg class="input-icon"
                                     viewBox="0 0 24 24">

                                    <rect x="4"
                                          y="10"
                                          width="16"
                                          height="10"
                                          rx="2" />

                                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                                </svg>

                                <input type="password"
                                       id="password"
                                       name="password"
                                       placeholder="Enter your password"
                                       autocomplete="current-password"
                                       maxlength="100"
                                       required />

                                <button type="button"
                                        class="password-toggle"
                                        onclick="togglePassword()"
                                        aria-label="Show password">

                                    <svg id="eyeIcon"
                                         viewBox="0 0 24 24">

                                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />

                                        <circle cx="12"
                                                cy="12"
                                                r="3" />

                                    </svg>

                                </button>

                            </div>

                        </div>


                        <!-- LOGIN BUTTON -->

                        <button type="submit"
                                id="loginButton"
                                class="auth-button">

                            <span id="loginButtonText">
                                Sign In
                            </span>

                            <span id="loginLoader"
                                  class="loader"
                                  style="display:none;">
                            </span>

                            <svg class="button-arrow"
                                 viewBox="0 0 24 24">

                                <path d="M5 12h14" />

                                <path d="m13 6 6 6-6 6" />

                            </svg>

                        </button>

                    </form>


                    <!-- SECURITY -->

                    <div class="security-note">

                        <svg viewBox="0 0 24 24">

                            <rect x="4"
                                  y="10"
                                  width="16"
                                  height="10"
                                  rx="2" />

                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                        </svg>

                        <span>
                            Your connection is secure and encrypted
                        </span>

                    </div>


                    <!-- FOOTER -->

                    <div class="auth-footer">

                        <span>
                            © @DateTime.Now.Year RCM Smart Meter Dashboard
                        </span>

                    </div>

                </div>

            </section>

        </div>

    </main>


    <script src="~/js/auth.js"
            asp-append-version="true">
    </script>

</body>

</html>