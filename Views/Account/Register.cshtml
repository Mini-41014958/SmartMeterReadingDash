@{
    ViewData["Title"] = "Register User";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Register User - Smart Meter Dashboard
    </title>

    <link rel="stylesheet" href="~/css/Auth.css" asp-append-version="true" />

</head>

<body>

    <div class="auth-page">

        <div class="auth-card register-card">

            <!-- ================================================= -->
            <!-- BRAND -->
            <!-- ================================================= -->

            <div class="auth-brand">

                <div class="brand-icon">
                    ⚡
                </div>

                <h1>Smart Meter</h1>

                <p>Reading Dashboard</p>

            </div>


            <!-- ================================================= -->
            <!-- CONTENT -->
            <!-- ================================================= -->

            <div class="auth-content">

                <div class="register-heading">

                    <div>
                        <h2>Create User</h2>

                        <p class="auth-subtitle">
                            Create an account and assign dashboard access.
                        </p>
                    </div>

                    <div class="security-badge">
                        <span class="security-dot"></span>
                        Secure
                    </div>

                </div>


                <form id="registerForm"
                      autocomplete="off">


                    <!-- ========================================= -->
                    <!-- USER INFORMATION -->
                    <!-- ========================================= -->

                    <div class="section-title">
                        <span class="section-number">01</span>
                        User Information
                    </div>


                    <div class="form-row">

                        <div class="form-group">

                            <label for="registerUsername">
                                Username
                            </label>

                            <div class="input-wrapper">

                                <span class="input-icon">
                                    👤
                                </span>

                                <input type="text"
                                       id="registerUsername"
                                       placeholder="Enter username"
                                       autocomplete="username"
                                       maxlength="50"
                                       required />

                            </div>

                        </div>


                        <div class="form-group">

                            <label for="fullName">
                                Full Name
                            </label>

                            <div class="input-wrapper">

                                <span class="input-icon">
                                    ◉
                                </span>

                                <input type="text"
                                       id="fullName"
                                       placeholder="Enter full name"
                                       maxlength="100"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- ========================================= -->
                    <!-- PASSWORD -->
                    <!-- ========================================= -->

                    <div class="section-title section-spaced">
                        <span class="section-number">02</span>
                        Password
                    </div>


                    <div class="form-row">

                        <div class="form-group">

                            <label for="registerPassword">
                                Password
                            </label>

                            <div class="password-wrapper">

                                <span class="input-icon">
                                    🔒
                                </span>

                                <input type="password"
                                       id="registerPassword"
                                       placeholder="Minimum 8 characters"
                                       autocomplete="new-password"
                                       maxlength="100"
                                       required />

                                <button type="button"
                                        class="password-toggle"
                                        onclick="toggleRegisterPassword()"
                                        aria-label="Show password">
                                    Show
                                </button>

                            </div>

                            <div class="password-strength">

                                <div class="strength-bars">

                                    <span></span>
                                    <span></span>
                                    <span></span>
                                    <span></span>

                                </div>

                                <span id="passwordStrengthText">
                                    Enter a password
                                </span>

                            </div>

                        </div>


                        <div class="form-group">

                            <label for="confirmPassword">
                                Confirm Password
                            </label>

                            <div class="password-wrapper">

                                <span class="input-icon">
                                    🔐
                                </span>

                                <input type="password"
                                       id="confirmPassword"
                                       placeholder="Confirm password"
                                       autocomplete="new-password"
                                       maxlength="100"
                                       required />

                                <span id="passwordMatchIcon"
                                      class="password-match-icon">
                                </span>

                            </div>

                            <div id="passwordMatchText"
                                 class="field-hint">
                            </div>

                        </div>

                    </div>


                    <!-- ========================================= -->
                    <!-- ACCESS -->
                    <!-- ========================================= -->

                    <div class="section-title section-spaced">
                        <span class="section-number">03</span>
                        Access & Scope
                    </div>


                    <div class="access-info">

                        <div class="info-icon">
                            🔐
                        </div>

                        <div>
                            <strong>Dashboard Access</strong>

                            <p>
                                Select the user's role, company and
                                optional department scope.
                            </p>
                        </div>

                    </div>


                    <div class="form-row">

                        <!-- ROLE -->

                        <div class="form-group">

                            <label for="registerRole">
                                Role
                            </label>

                            <div class="select-wrapper">

                                <select id="registerRole"
                                        required>

                                    <option value="USER">
                                        User
                                    </option>

                                    <option value="ADMIN">
                                        Administrator
                                    </option>

                                </select>

                            </div>

                        </div>


                        <!-- COMPANY -->

                        <div class="form-group">

                            <label for="registerCompany">
                                Company
                            </label>

                            <div class="select-wrapper">

                                <select id="registerCompany"
                                        required>

                                    <option value="">
                                        Select company
                                    </option>

                                    <option value="BRPL">
                                        BRPL
                                    </option>

                                    <option value="BYPL">
                                        BYPL
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- DEPARTMENT -->

                    <div class="form-group">

                        <label for="registerDepartment">

                            Department

                            <span class="optional-label">
                                Optional
                            </span>

                        </label>

                        <div class="select-wrapper">

                            <select id="registerDepartment"
                                    disabled>

                                <option value="">
                                    All Departments
                                </option>

                            </select>

                        </div>

                        <div class="field-hint">
                            Leave as "All Departments" for
                            company-wide access.
                        </div>

                    </div>


                    <!-- ========================================= -->
                    <!-- MESSAGE -->
                    <!-- ========================================= -->

                    <div id="registerMessage"
                         class="auth-message"
                         style="display:none;">
                    </div>


                    <!-- ========================================= -->
                    <!-- SUBMIT -->
                    <!-- ========================================= -->

                    <button type="submit"
                            id="registerButton"
                            class="auth-button">

                        <span id="registerButtonText">
                            Create User
                        </span>

                        <span id="registerLoader"
                              class="loader"
                              style="display:none;">
                        </span>

                    </button>


                </form>


                <!-- ============================================= -->
                <!-- BACK -->
                <!-- ============================================= -->

                <div class="back-login">

                    <a href="/Account/Login">
                        ← Back to Login
                    </a>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <div class="auth-footer">
                Smart Meter Reading Dashboard
            </div>

        </div>

    </div>


    <script src="~/js/Auth.js" asp-append-version="true"> </script>

</body>
</html>